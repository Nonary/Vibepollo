# Read the PE/COFF machine directly: import resolution alone can accept a DLL
# with the right name but the wrong architecture. No extra packaging tool is
# needed. Native x86, AMD64 and ARM64 images are the supported formats.
# These are basic header and section file bounds, not a Windows loader verifier.
function(sunshine_portable_validate_pe path machine)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Invalid portable PE image: ${path}")
    endif()
    file(SIZE "${path}" _size)
    if(_size LESS 64)
        message(FATAL_ERROR "Invalid portable PE image (truncated DOS header): ${path}")
    endif()
    file(READ "${path}" _dos LIMIT 64 HEX)
    string(SUBSTRING "${_dos}" 0 4 _signature)
    if(NOT _signature STREQUAL "4d5a")
        message(FATAL_ERROR "Invalid portable PE image (DOS signature): ${path}")
    endif()
    string(SUBSTRING "${_dos}" 120 2 _b0)
    string(SUBSTRING "${_dos}" 122 2 _b1)
    string(SUBSTRING "${_dos}" 124 2 _b2)
    string(SUBSTRING "${_dos}" 126 2 _b3)
    math(EXPR _pe "0x${_b3}${_b2}${_b1}${_b0}")
    math(EXPR _minimum_size "${_pe} + 26")
    if(_pe LESS 64 OR _minimum_size GREATER _size)
        message(FATAL_ERROR "Invalid portable PE image (PE header offset): ${path}")
    endif()
    file(READ "${path}" _coff OFFSET ${_pe} LIMIT 26 HEX)
    string(SUBSTRING "${_coff}" 0 8 _signature)
    if(NOT _signature STREQUAL "50450000")
        message(FATAL_ERROR "Invalid portable PE image (PE signature): ${path}")
    endif()
    string(SUBSTRING "${_coff}" 8 4 _machine)
    if(NOT _machine MATCHES "^(4c01|6486|64aa)$")
        message(FATAL_ERROR "Unknown portable PE machine ${_machine}: ${path}")
    endif()
    if(NOT _machine STREQUAL machine)
        message(FATAL_ERROR "Portable PE architecture mismatch (${_machine}, expected ${machine}): ${path}")
    endif()
    string(SUBSTRING "${_coff}" 12 2 _b0)
    string(SUBSTRING "${_coff}" 14 2 _b1)
    math(EXPR _sections "0x${_b1}${_b0}")
    string(SUBSTRING "${_coff}" 40 2 _b0)
    string(SUBSTRING "${_coff}" 42 2 _b1)
    math(EXPR _optional_size "0x${_b1}${_b0}")
    string(SUBSTRING "${_coff}" 48 4 _magic)
    if(machine STREQUAL "4c01")
        set(_expected_magic "0b01")
        set(_minimum_optional_size 96)
    else()
        set(_expected_magic "0b02")
        set(_minimum_optional_size 112)
    endif()
    math(EXPR _header_end "${_pe} + 24 + ${_optional_size} + 40 * ${_sections}")
    if(NOT _magic STREQUAL _expected_magic OR _optional_size LESS _minimum_optional_size OR
            _sections EQUAL 0 OR _header_end GREATER _size)
        message(FATAL_ERROR "Invalid portable PE image (optional/section headers): ${path}")
    endif()
    # Import scanners can accept a PE whose code section points beyond EOF.
    # Check every file-backed section, including sections without imports.
    # Zero-sized raw data is legitimate for uninitialized/zero-filled sections;
    # virtual sizes, RVA mapping, alignment and trailing data are not checked.
    math(EXPR _last_section "${_sections} - 1")
    foreach(_section RANGE ${_last_section})
        math(EXPR _raw_fields "${_pe} + 24 + ${_optional_size} + 40 * ${_section} + 16")
        file(READ "${path}" _raw OFFSET ${_raw_fields} LIMIT 8 HEX)
        string(SUBSTRING "${_raw}" 0 2 _b0)
        string(SUBSTRING "${_raw}" 2 2 _b1)
        string(SUBSTRING "${_raw}" 4 2 _b2)
        string(SUBSTRING "${_raw}" 6 2 _b3)
        math(EXPR _raw_size "0x${_b3}${_b2}${_b1}${_b0}")
        string(SUBSTRING "${_raw}" 8 2 _b0)
        string(SUBSTRING "${_raw}" 10 2 _b1)
        string(SUBSTRING "${_raw}" 12 2 _b2)
        string(SUBSTRING "${_raw}" 14 2 _b3)
        math(EXPR _raw_offset "0x${_b3}${_b2}${_b1}${_b0}")
        # CMake uses signed 64-bit arithmetic, so two 32-bit PE fields cannot
        # wrap this sum and turn an out-of-file range into an accepted one.
        math(EXPR _raw_end "${_raw_offset} + ${_raw_size}")
        if(_raw_size GREATER 0 AND (_raw_offset LESS _header_end OR _raw_end GREATER _size))
            message(FATAL_ERROR "Invalid portable PE image (section raw data bounds): ${path}")
        endif()
    endforeach()
endfunction()

# Runs after CPack installs the payload and before it creates the ZIP.
function(sunshine_prepare_windows_portable)
    cmake_parse_arguments(PORTABLE "" "STAGE;OBJDUMP;PROCESSOR" "REQUIRED_FILES;EXECUTABLES;LIBRARIES;REDISTRIBUTABLE_DIRS" ${ARGN})
    if(NOT IS_ABSOLUTE "${PORTABLE_STAGE}" OR NOT IS_DIRECTORY "${PORTABLE_STAGE}")
        message(FATAL_ERROR "Portable package staging directory is missing: ${PORTABLE_STAGE}")
    endif()
    if(EXISTS "${PORTABLE_STAGE}/config")
        message(FATAL_ERROR "Portable packages must not include an existing config directory or credentials.")
    endif()
    string(TOLOWER "${PORTABLE_PROCESSOR}" _processor)
    if(_processor MATCHES "^(amd64|x86_64)$")
        set(_machine "6486")
    elseif(_processor MATCHES "^(arm64|aarch64)$")
        set(_machine "64aa")
    elseif(_processor MATCHES "^(x86|i[3-6]86)$")
        set(_machine "4c01")
    else()
        message(FATAL_ERROR "Unsupported portable target architecture: ${PORTABLE_PROCESSOR}")
    endif()
    # This bootstrapper manages installed MSI products and has no role in
    # removing a portable folder. Keep it in MSI packages only.
    file(REMOVE "${PORTABLE_STAGE}/uninstall.exe")
    foreach(_required IN LISTS PORTABLE_REQUIRED_FILES)
        if(NOT EXISTS "${PORTABLE_STAGE}/${_required}" OR IS_DIRECTORY "${PORTABLE_STAGE}/${_required}")
            message(FATAL_ERROR "Required portable runtime file missing: ${_required}")
        endif()
        file(SIZE "${PORTABLE_STAGE}/${_required}" _size)
        if(_size EQUAL 0)
            message(FATAL_ERROR "Required portable runtime file is empty: ${_required}")
        endif()
    endforeach()
    foreach(_web_assets IN ITEMS assets/web/assets assets/web/v2/assets)
        file(GLOB _scripts "${PORTABLE_STAGE}/${_web_assets}/*.js")
        if(NOT _scripts)
            message(FATAL_ERROR "Portable Web UI bundle missing: ${_web_assets}")
        endif()
        foreach(_script IN LISTS _scripts)
            file(SIZE "${_script}" _size)
            if(_size EQUAL 0)
                message(FATAL_ERROR "Portable Web UI bundle is empty: ${_script}")
            endif()
        endforeach()
    endforeach()

    # Catch imports satisfied on a developer's machine but absent from the ZIP.
    # zlib/TrueHDR are also checked explicitly above because they are dlopened.
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
    if(PORTABLE_OBJDUMP)
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${PORTABLE_OBJDUMP}")
    endif()
    set(_executables "")
    set(_libraries "")
    foreach(_executable IN LISTS PORTABLE_EXECUTABLES)
        list(APPEND _executables "${PORTABLE_STAGE}/${_executable}")
    endforeach()
    foreach(_library IN LISTS PORTABLE_LIBRARIES)
        list(APPEND _libraries "${PORTABLE_STAGE}/${_library}")
    endforeach()
    foreach(_image IN LISTS _executables _libraries)
        sunshine_portable_validate_pe("${_image}" "${_machine}")
    endforeach()
    # Resolve and stage only imported release compiler redistributables. Repeat
    # the scan because a newly copied CRT can itself import another CRT DLL.
    # Other external dependencies, debug CRTs and genuinely missing imports must
    # still fail the final closure checks below.
    file(TO_CMAKE_PATH "$ENV{SystemRoot}" _windows_source_root)
    string(TOLOWER "${_windows_source_root}" _windows_source_root)
    string(REGEX REPLACE "/+$" "" _windows_source_root "${_windows_source_root}")
    foreach(_runtime_pass RANGE 0 31)
        file(GET_RUNTIME_DEPENDENCIES
            EXECUTABLES ${_executables}
            LIBRARIES ${_libraries}
            DIRECTORIES "${PORTABLE_STAGE}" "${PORTABLE_STAGE}/tools" ${PORTABLE_REDISTRIBUTABLE_DIRS}
            RESOLVED_DEPENDENCIES_VAR _resolved
            UNRESOLVED_DEPENDENCIES_VAR _unresolved
            CONFLICTING_DEPENDENCIES_PREFIX _conflicts
            PRE_EXCLUDE_REGEXES "^(api|ext)-ms-win-")
        foreach(_dependency IN LISTS _resolved)
            sunshine_portable_validate_pe("${_dependency}" "${_machine}")
        endforeach()
        set(_copied_runtime FALSE)
        foreach(_dependency IN LISTS _resolved _unresolved)
            get_filename_component(_runtime_name "${_dependency}" NAME)
            string(TOLOWER "${_runtime_name}" _runtime_name)
            # Debug UCRT is neither redistributable nor a Windows dependency
            # guaranteed on a clean host, including when resolved in System32.
            if(_runtime_name STREQUAL "ucrtbased.dll")
                message(FATAL_ERROR "Portable package imports a non-redistributable debug CRT: ${_runtime_name}")
            endif()
            if(NOT _runtime_name MATCHES "^(msvcp|msvcr|vcruntime|concrt|vcomp)[0-9].*[.]dll$" AND
                    NOT _runtime_name MATCHES "^lib(gcc|stdc\\+\\+|winpthread).*[.]dll$")
                continue()
            endif()
            if(_runtime_name MATCHES "[0-9]d([.]dll$|_)")
                message(FATAL_ERROR "Portable package imports a non-redistributable debug CRT: ${_runtime_name}")
            endif()
            if(EXISTS "${PORTABLE_STAGE}/${_runtime_name}")
                continue()
            endif()
            set(_runtime_source "")
            foreach(_runtime_dir IN LISTS PORTABLE_REDISTRIBUTABLE_DIRS)
                file(GLOB _runtime_candidates "${_runtime_dir}/*")
                foreach(_candidate IN LISTS _runtime_candidates)
                    get_filename_component(_candidate_name "${_candidate}" NAME)
                    string(TOLOWER "${_candidate_name}" _candidate_name)
                    if(NOT _candidate_name STREQUAL _runtime_name OR IS_DIRECTORY "${_candidate}")
                        continue()
                    endif()
                    file(REAL_PATH "${_candidate}" _candidate_path)
                    string(TOLOWER "${_candidate_path}" _candidate_path)
                    if(NOT _windows_source_root STREQUAL "")
                        string(FIND "${_candidate_path}" "${_windows_source_root}/" _in_windows)
                        if(_in_windows EQUAL 0)
                            continue()
                        endif()
                    endif()
                    set(_runtime_source "${_candidate}")
                    break()
                endforeach()
                if(NOT _runtime_source STREQUAL "")
                    break()
                endif()
            endforeach()
            if(NOT _runtime_source STREQUAL "")
                sunshine_portable_validate_pe("${_runtime_source}" "${_machine}")
                file(COPY_FILE "${_runtime_source}" "${PORTABLE_STAGE}/${_runtime_name}")
                set(_copied_runtime TRUE)
            endif()
        endforeach()
        if(NOT _copied_runtime)
            break()
        endif()
    endforeach()
    if(_copied_runtime)
        message(FATAL_ERROR "Portable compiler runtime dependency closure exceeded 32 staging passes.")
    endif()
    # The pinned nvngx_truehdr.dll imports nvcuda.dll eagerly, but the host loads
    # its TrueHDR shim only when RTX HDR is used. Never allow this exception to
    # conceal an eager import by sunshine.exe or another always-loaded image.
    file(GLOB_RECURSE _portable_images LIST_DIRECTORIES FALSE
        "${PORTABLE_STAGE}/*.exe" "${PORTABLE_STAGE}/*.dll")
    foreach(_image IN LISTS _portable_images)
        # The Playnite extension can carry a managed/non-PE fixture; the
        # native images are checked by the dependency scan above.
        file(READ "${_image}" _signature OFFSET 0 LIMIT 2 HEX)
        if(NOT _signature STREQUAL "4d5a")
            continue()
        endif()
        execute_process(COMMAND "${PORTABLE_OBJDUMP}" -p "${_image}"
            RESULT_VARIABLE _dump_status OUTPUT_VARIABLE _imports ERROR_VARIABLE _dump_error)
        if(NOT _dump_status EQUAL 0)
            message(FATAL_ERROR "Cannot inspect portable DLL imports: ${_image}: ${_dump_error}")
        endif()
        string(TOLOWER "${_imports}" _imports)
        if(_imports MATCHES "dll name:[ \t]*nvcuda[.]dll")
            file(REAL_PATH "${_image}" _importer)
            file(REAL_PATH "${PORTABLE_STAGE}/nvngx_truehdr.dll" _expected_ngx)
            if(NOT _importer STREQUAL _expected_ngx)
                message(FATAL_ERROR "Unexpected eager nvcuda.dll import in portable image: ${_image}")
            endif()
        endif()
    endforeach()
    # nvcuda.dll is supplied by an installed NVIDIA display driver. A CPU-only
    # packaging runner cannot resolve it, and bundling a driver DLL is invalid.
    set(_unresolved_package_imports "")
    foreach(_dependency IN LISTS _unresolved)
        string(TOLOWER "${_dependency}" _dependency_lower)
        if(NOT _dependency_lower STREQUAL "nvcuda.dll")
            list(APPEND _unresolved_package_imports "${_dependency}")
        endif()
    endforeach()
    if(_unresolved_package_imports)
        message(FATAL_ERROR "Unresolved portable DLL imports: ${_unresolved_package_imports}")
    endif()
    if(_conflicts_FILENAMES)
        message(FATAL_ERROR "Conflicting portable DLL imports: ${_conflicts_FILENAMES}")
    endif()
    file(REAL_PATH "${PORTABLE_STAGE}" _stage)
    string(TOLOWER "${_stage}/" _stage)
    file(TO_CMAKE_PATH "$ENV{SystemRoot}" _windows)
    string(TOLOWER "${_windows}" _windows)
    string(REGEX REPLACE "/+$" "" _windows "${_windows}")
    foreach(_dependency IN LISTS _resolved)
        file(REAL_PATH "${_dependency}" _dependency_path)
        string(TOLOWER "${_dependency_path}" _dependency_path)
        string(FIND "${_dependency_path}" "${_stage}" _in_stage)
        set(_system_dependency FALSE)
        if(NOT _windows STREQUAL "")
            foreach(_system_dir IN ITEMS System32 SysWOW64)
                string(TOLOWER "${_windows}/${_system_dir}/" _system_prefix)
                string(FIND "${_dependency_path}" "${_system_prefix}" _in_system)
                if(_in_system EQUAL 0)
                    set(_system_dependency TRUE)
                endif()
            endforeach()
        endif()
        # VC/MinGW redistributables can be present in a developer's System32
        # without being part of Windows. They must travel with the package.
        get_filename_component(_dependency_name "${_dependency_path}" NAME)
        if(_dependency_name MATCHES "^(msvcp|msvcr|vcruntime|concrt|vcomp)[0-9].*\\.dll$" OR
                _dependency_name MATCHES "^lib(gcc|stdc\\+\\+|winpthread).*[.]dll$")
            set(_system_dependency FALSE)
        endif()
        if(NOT _in_stage EQUAL 0 AND NOT _system_dependency)
            message(FATAL_ERROR "Portable DLL dependency is not bundled: ${_dependency}")
        endif()
    endforeach()

    file(MAKE_DIRECTORY "${PORTABLE_STAGE}/config")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/sunshine.conf"
        "${PORTABLE_STAGE}/config/sunshine.conf" COPYONLY)
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/start-portable.cmd"
        "${PORTABLE_STAGE}/start-portable.cmd" @ONLY NEWLINE_STYLE CRLF)
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/README-portable.txt"
        "${PORTABLE_STAGE}/README-portable.txt" COPYONLY)
endfunction()
