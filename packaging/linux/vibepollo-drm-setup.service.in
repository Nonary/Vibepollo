[Unit]
Description=Build and install Vibepollo HDR DRM module
Documentation=https://github.com/Nonary/vibepollo
After=local-fs.target
Before=vibepollo-vkms.service display-manager.service

[Service]
Type=oneshot
ExecStart=@VIBEPOLLO_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibepollo-drm-install install
TimeoutStartSec=10min
UMask=0022
