[Unit]
Description=Vibepollo private VKMS display pool
Documentation=https://docs.kernel.org/gpu/vkms.html
Wants=vibepollo-drm-setup.service vibepollo-vkms-control.socket
After=systemd-modules-load.service vibepollo-drm-setup.service
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@VIBEPOLLO_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibepollo-vkms start
ExecStop=@VIBEPOLLO_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibepollo-vkms stop
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0022

[Install]
WantedBy=multi-user.target
