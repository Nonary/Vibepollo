[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/libkwin.so*
Target = usr/lib/vibepollo/kwin-bridge/libvibeshine-kwin-gpu.so

[Action]
Description = Deactivating the Vibepollo GPU bridge before compositor files change
When = PreTransaction
Depends = vibepollo
Exec = /usr/libexec/vibeshine/vibepollo-kwin-bridge-rebuild --deactivate
AbortOnFail
