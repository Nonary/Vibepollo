#!/usr/bin/bash

set -euo pipefail

readonly runtime_root=/run/vibepollo
readonly marker_directory=$runtime_root/session-handoffs
readonly restore_directory=$runtime_root/session-restores
readonly transition_lock=$runtime_root/session-handoff.lock
readonly control_socket=/run/vibeshine/vkms-control.sock
readonly prelogin_service=vibepollo-prelogin.service
readonly desktop_service=app-io.github.Nonary.vibepollo.service
readonly desktop_target=graphical-session.target
readonly desktop_compositor=plasma-kwin_wayland.service
readonly restore_unit_prefix=vibepollo-session-restore@
readonly greeter_user=plasmalogin
readonly greeter_target=plasma-login-wayland.target
readonly virtual_output=Virtual-1
readonly maximum_delay=5
readonly socket_timeout=3

state_user=''
state_uid=''
state_token=''

valid_user() { [[ -n "$1" && "$1" != *:* && "$1" != *$'\n'* && "$1" != *$'\r'* ]]; }
valid_uid() { [[ "$1" =~ ^[0-9]+$ && "$1" -gt 0 ]]; }
valid_token() { [[ "$1" =~ ^[0-9a-f]{32}$ ]]; }

validate_identity() {
  local desktop_user=$1 desktop_uid=$2 passwd_entry
  valid_user "$desktop_user" && valid_uid "$desktop_uid" || return 1
  passwd_entry=$(/usr/bin/getent passwd "$desktop_uid") || return 1
  [[ "${passwd_entry%%:*}" == "$desktop_user" ]] || return 1
  [[ $(/usr/bin/id -u -- "$desktop_user") == "$desktop_uid" ]]
}

initialize_runtime() {
  local attributes
  ((EUID == 0)) || return 1
  /usr/bin/install -d -o root -g root -m 0755 "$runtime_root" "$marker_directory"
  /usr/bin/install -d -o root -g root -m 0700 "$restore_directory"
  [[ $(/usr/bin/stat -c '%U:%G:%a:%F' -- "$runtime_root") == "root:root:755:directory" ]] || return 1
  [[ $(/usr/bin/stat -c '%U:%G:%a:%F' -- "$marker_directory") == "root:root:755:directory" ]] || return 1
  [[ $(/usr/bin/stat -c '%U:%G:%a:%F' -- "$restore_directory") == "root:root:700:directory" ]] || return 1
  if [[ -e "$transition_lock" || -L "$transition_lock" ]]; then
    [[ -f "$transition_lock" && ! -L "$transition_lock" ]] || return 1
    attributes=$(/usr/bin/stat -c '%U:%G:%a:%F' -- "$transition_lock") || return 1
    [[ "$attributes" == "root:root:600:regular file" ]] || return 1
  else
    /usr/bin/install -o root -g root -m 0600 /dev/null "$transition_lock"
  fi
}

lock_transition() {
  initialize_runtime
  exec 9>"$transition_lock"
  /usr/bin/flock --exclusive --timeout 30 9
}

should_log_attempt() {
  local attempt=$1
  ((attempt == 0 || (attempt & (attempt - 1)) == 0))
}

user_systemctl() {
  local desktop_user=$1
  shift
  local desktop_uid runtime_directory
  desktop_uid=$(/usr/bin/id -u -- "$desktop_user")
  runtime_directory=/run/user/$desktop_uid
  [[ -S "$runtime_directory/bus" ]] || return 1
  /usr/bin/timeout --signal=KILL 25 \
    /usr/bin/runuser -u "$desktop_user" -- \
      /usr/bin/env -i "XDG_RUNTIME_DIR=$runtime_directory" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=$runtime_directory/bus" \
        /usr/bin/systemctl --user "$@"
}

queue_desktop_service() {
  local desktop_user=$1
  if user_systemctl "$desktop_user" reset-failed "$desktop_service" &&
     user_systemctl "$desktop_user" start --no-block "$desktop_service"; then
    return 0
  fi
  /usr/bin/printf 'vibepollo-session-handoff: user manager is not ready; graphical-session.target will start %s later\n' "$desktop_service" >&2
}

stop_desktop_session() {
  local desktop_user=$1
  if user_systemctl "$desktop_user" stop "$desktop_target"; then
    if ! user_systemctl "$desktop_user" stop "$desktop_service"; then
      user_systemctl "$desktop_user" kill --kill-whom=all --signal=KILL "$desktop_service" || :
    fi
  else
    /usr/bin/printf 'vibepollo-session-handoff: desktop target did not stop cleanly; forcing capture owners down\n' >&2
    user_systemctl "$desktop_user" kill --kill-whom=all --signal=KILL "$desktop_service" || :
    user_systemctl "$desktop_user" kill --kill-whom=all --signal=KILL "$desktop_compositor" || :
  fi
}

stream_ports_are_free() {
  local listeners
  listeners=$({
    /usr/bin/timeout --signal=KILL 3 /usr/bin/ss -H -ltnp
    /usr/bin/timeout --signal=KILL 3 /usr/bin/ss -H -lunp
  }) || return 1
  ! /usr/bin/awk '
    $4 ~ /:(47984|47989|47990|47998|47999|48000|48002|48010)$/ { found = 1 }
    END { exit(found ? 0 : 1) }
  ' <<<"$listeners"
}

connector_request() {
  local request=$1
  [[ -S "$control_socket" && ! -L "$control_socket" ]] || return 1
  /usr/bin/printf '%s\n' "$request" |
    /usr/bin/timeout --signal=KILL "$socket_timeout" \
      /usr/bin/socat - "UNIX-CONNECT:$control_socket"
}

connector_status() { connector_request "status $virtual_output"; }

release_connector() {
  local response status
  status=$(connector_status) || return 1
  case "$status" in
    "STATUS disconnected $virtual_output") return 0 ;;
    "STATUS connected $virtual_output")
      response=$(connector_request "disconnect $virtual_output") || return 1
      [[ "$response" == "OK disconnected $virtual_output" ]]
      ;;
    *)
      /usr/bin/printf 'vibepollo-session-handoff: unexpected connector status: %s\n' "$status" >&2
      return 1
      ;;
  esac
}

state_path() { /usr/bin/printf '%s/%s\n' "$1" "$2"; }

write_state_file() {
  local directory=$1 desktop_user=$2 desktop_uid=$3 token=$4 mode=$5
  local destination temporary
  destination=$(state_path "$directory" "$desktop_uid")
  temporary=$(/usr/bin/mktemp --tmpdir="$directory" .session.XXXXXX)
  /usr/bin/printf '%s\n%s\n%s\n' "$desktop_user" "$desktop_uid" "$token" >"$temporary"
  /usr/bin/chown root:root "$temporary"
  /usr/bin/chmod "$mode" "$temporary"
  /usr/bin/mv -fT -- "$temporary" "$destination"
}

read_state_file() {
  local path=$1 expected_mode=$2 attributes
  local -a fields
  [[ -f "$path" && ! -L "$path" ]] || return 1
  attributes=$(/usr/bin/stat -c '%U:%G:%a:%F' -- "$path") || return 1
  [[ "$attributes" == "root:root:${expected_mode}:regular file" ]] || return 1
  mapfile -t fields <"$path"
  [[ ${#fields[@]} == 3 ]] || return 1
  validate_identity "${fields[0]}" "${fields[1]}" || return 1
  valid_token "${fields[2]}" || return 1
  state_user=${fields[0]}
  state_uid=${fields[1]}
  state_token=${fields[2]}
}

remove_state_file() { /usr/bin/rm -f -- "$(state_path "$1" "$2")"; }

other_handoff_exists() {
  local desktop_uid=$1 candidate
  local -a candidates
  shopt -s nullglob
  candidates=("$marker_directory"/*)
  shopt -u nullglob
  for candidate in "${candidates[@]}"; do
    [[ ${candidate##*/} == "$desktop_uid" ]] || return 0
  done
  return 1
}

any_handoff_exists() {
  local candidate
  shopt -s nullglob
  for candidate in "$marker_directory"/*; do
    shopt -u nullglob
    return 0
  done
  shopt -u nullglob
  return 1
}

rollback_to_prelogin() {
  local desktop_uid=$1
  remove_state_file "$marker_directory" "$desktop_uid"
  user_systemctl "$greeter_user" reset-failed || :
  user_systemctl "$greeter_user" start "$greeter_target" || :
  /usr/bin/systemctl reset-failed "$prelogin_service" || :
  /usr/bin/systemctl start --no-block "$prelogin_service" || :
}

pam_open() {
  local desktop_user=$1 desktop_uid=$2 token=$3 attempt marker
  ((EUID == 0)) || return 1
  validate_identity "$desktop_user" "$desktop_uid" && valid_token "$token" || return 1
  lock_transition
  /usr/bin/systemctl stop "${restore_unit_prefix}${desktop_uid}.service" || :
  remove_state_file "$restore_directory" "$desktop_uid"
  if other_handoff_exists "$desktop_uid"; then
    /usr/bin/printf 'vibepollo-session-handoff: another desktop session owns the stream handoff\n' >&2
    return 1
  fi
  if user_systemctl "$desktop_user" is-active --quiet "$desktop_target"; then
    stop_desktop_session "$desktop_user"
  fi
  remove_state_file "$marker_directory" "$desktop_uid"
  if ! /usr/bin/timeout --signal=KILL 25 /usr/bin/systemctl stop "$prelogin_service"; then
    /usr/bin/systemctl kill --kill-whom=all --signal=KILL "$prelogin_service" || :
  fi
  for ((attempt = 0; attempt < 100; ++attempt)); do
    if ! /usr/bin/systemctl is-active --quiet "$prelogin_service" && stream_ports_are_free; then
      break
    fi
    /usr/bin/sleep 0.1
  done
  if ((attempt == 100)); then
    /usr/bin/printf 'vibepollo-session-handoff: pre-login stream did not stop safely; rolling back\n' >&2
    rollback_to_prelogin "$desktop_uid"
    return 1
  fi
  if ! release_connector || [[ $(connector_status) != "STATUS disconnected $virtual_output" ]]; then
    /usr/bin/printf 'vibepollo-session-handoff: virtual connector release failed; rolling back\n' >&2
    rollback_to_prelogin "$desktop_uid"
    return 1
  fi
  if ! write_state_file "$marker_directory" "$desktop_user" "$desktop_uid" "$token" 0644; then
    rollback_to_prelogin "$desktop_uid"
    return 1
  fi
  marker=$(state_path "$marker_directory" "$desktop_uid")
  [[ -f "$marker" ]] || { rollback_to_prelogin "$desktop_uid"; return 1; }
  queue_desktop_service "$desktop_user"
}

pam_close() {
  local desktop_user=$1 desktop_uid=$2 token=$3 marker
  ((EUID == 0)) || return 0
  validate_identity "$desktop_user" "$desktop_uid" && valid_token "$token" || return 0
  lock_transition || return 0
  marker=$(state_path "$marker_directory" "$desktop_uid")
  if ! read_state_file "$marker" 644 || [[ "$state_token" != "$token" ]]; then
    return 0
  fi
  write_state_file "$restore_directory" "$desktop_user" "$desktop_uid" "$token" 0600
  /usr/bin/systemctl reset-failed "${restore_unit_prefix}${desktop_uid}.service" || :
  if ! /usr/bin/systemctl start --no-block "${restore_unit_prefix}${desktop_uid}.service"; then
    /usr/bin/printf 'vibepollo-session-handoff: could not queue pre-login restoration\n' >&2
  fi
  return 0
}

restore_prelogin() {
  local desktop_uid=$1 marker request request_token
  ((EUID == 0)) || return 1
  valid_uid "$desktop_uid" || return 1
  /usr/bin/sleep 1
  lock_transition
  request=$(state_path "$restore_directory" "$desktop_uid")
  read_state_file "$request" 600 || return 0
  request_token=$state_token
  marker=$(state_path "$marker_directory" "$desktop_uid")
  if ! read_state_file "$marker" 644 || [[ "$state_token" != "$request_token" ]]; then
    remove_state_file "$restore_directory" "$desktop_uid"
    return 0
  fi
  stop_desktop_session "$state_user"
  remove_state_file "$marker_directory" "$desktop_uid"
  remove_state_file "$restore_directory" "$desktop_uid"
  any_handoff_exists && return 0
  user_systemctl "$greeter_user" reset-failed || :
  if ! user_systemctl "$greeter_user" start "$greeter_target"; then
    /usr/bin/printf 'vibepollo-session-handoff: greeter target is not ready; pre-login retries will wait for it\n' >&2
  fi
  /usr/bin/systemctl reset-failed "$prelogin_service" || :
  /usr/bin/systemctl start --no-block "$prelogin_service"
}

wait_prelogin() {
  local attempt=0 delay=1
  ((EUID == 0)) || return 1
  while any_handoff_exists || ! stream_ports_are_free; do
    if should_log_attempt "$attempt"; then
      /usr/bin/printf 'vibepollo-session-handoff: waiting for desktop stream resources to drain (attempt %d)\n' "$((attempt + 1))" >&2
    fi
    /usr/bin/sleep "$delay"
    ((attempt += 1))
    if ((delay < maximum_delay)); then
      ((delay *= 2))
      ((delay > maximum_delay)) && delay=$maximum_delay
    fi
  done
}

verify() {
  local expected_uid expected_user marker
  expected_uid=$(/usr/bin/id -u)
  expected_user=$(/usr/bin/id -un)
  marker=$(state_path "$marker_directory" "$expected_uid")
  read_state_file "$marker" 644 || {
    /usr/bin/printf 'vibepollo-session-handoff: missing trusted handoff state\n' >&2
    return 1
  }
  if [[ "$state_user" != "$expected_user" || "$state_uid" != "$expected_uid" ]]; then
    /usr/bin/printf 'vibepollo-session-handoff: handoff state belongs to another account\n' >&2
    return 1
  fi
  if /usr/bin/systemctl is-active --quiet "$prelogin_service" || ! stream_ports_are_free; then
    /usr/bin/printf 'vibepollo-session-handoff: pre-login resources are still active\n' >&2
    return 1
  fi
}

case "${1:-}" in
  pam-open) [[ $# == 4 ]] || exit 2; pam_open "$2" "$3" "$4" ;;
  pam-close) [[ $# == 4 ]] || exit 2; pam_close "$2" "$3" "$4" ;;
  restore) [[ $# == 2 ]] || exit 2; restore_prelogin "$2" ;;
  verify) [[ $# == 1 ]] || exit 2; verify ;;
  wait-prelogin) [[ $# == 1 ]] || exit 2; wait_prelogin ;;
  *)
    /usr/bin/printf 'usage: %s {pam-open USER UID TOKEN|pam-close USER UID TOKEN|restore UID|verify|wait-prelogin}\n' "$0" >&2
    exit 2
    ;;
esac
