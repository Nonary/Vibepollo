#!/usr/bin/bash

set -euo pipefail

readonly settings_file=/etc/vibepollo/machine.conf
readonly legacy_settings_file=/etc/vibepollo/prelogin.conf
readonly pam_file=/etc/pam.d/plasmalogin
readonly pam_line='session     optional    pam_vibepollo_session.so'
readonly service_user=vibepollo
readonly machine_profile=/var/lib/vibepollo
readonly profile_marker=$machine_profile/.machine-profile
readonly runtime_root=/run/vibepollo
readonly session_file=$runtime_root/session.env
readonly acl_state=$runtime_root/runtime-acl
readonly command_manifest=/etc/vibepollo/session-commands
readonly handoff_directory=$runtime_root/session-handoffs
readonly greeter_user=plasmalogin
readonly virtual_output=Virtual-1

desktop_user=''; desktop_uid=''; desktop_gid=''; desktop_home=''
session_user=''; session_uid=''; session_gid=''; session_home=''; session_runtime=''; session_display=''; session_xdisplay=''; session_groups=''; session_role=''; session_allowed_clients=''
declare -a allowed_client_uuids=()

fail() { /usr/bin/printf 'vibepollo-machine-host: %s\n' "$*" >&2; return 1; }
require_root() { ((EUID == 0)) || fail "$1 requires root"; }
valid_user() { [[ "$1" =~ ^[a-z_][a-z0-9_-]*$ ]]; }

resolve_desktop_identity() {
  local requested=$1 entry
  valid_user "$requested" || fail 'invalid desktop account name'
  entry=$(/usr/bin/getent passwd "$requested") || fail 'desktop account does not exist'
  IFS=: read -r desktop_user _ desktop_uid desktop_gid _ desktop_home _ <<<"$entry"
  [[ "$desktop_user" == "$requested" && "$desktop_uid" =~ ^[0-9]+$ && "$desktop_uid" -ge 1000 ]] || fail 'desktop account is invalid'
  [[ "$desktop_gid" =~ ^[0-9]+$ && "$desktop_home" == /* && -d "$desktop_home" && ! -L "$desktop_home" ]] || fail 'desktop home is unsafe'
}

read_desktop_user() {
  local source=$1 attributes key value line selected=''
  [[ -f "$source" && ! -L "$source" ]] || return 1
  attributes=$(/usr/bin/stat -c '%U:%G:%a:%F' -- "$source")
  [[ "$attributes" == 'root:root:600:regular file' ]] || fail "$source must be root:root mode 0600"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" && "$line" != \#* ]] || continue; key=${line%%=*}; value=${line#*=}
    case "$key" in
      desktop_user) [[ -z "$selected" ]] || fail 'multiple desktop users selected'; selected=$value ;;
      allowed_client_uuid) : ;; # parsed and validated separately
      *) fail "unknown setting in $source: $key" ;;
    esac
  done <"$source"
  [[ -n "$selected" ]] || fail "$source does not select a desktop user"; /usr/bin/printf '%s\n' "$selected"
}

read_allowed_clients() {
  local source=$1 attributes key value line normalized existing
  allowed_client_uuids=()
  [[ -f "$source" && ! -L "$source" ]] || return 1
  attributes=$(/usr/bin/stat -c '%U:%G:%a:%F' -- "$source")
  [[ "$attributes" == 'root:root:600:regular file' ]] || fail "$source must be root:root mode 0600"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" && "$line" != \#* ]] || continue; key=${line%%=*}; value=${line#*=}
    [[ "$key" == allowed_client_uuid ]] || continue
    normalized=${value^^}; existing=0
    [[ "$normalized" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]] || fail 'invalid allowed client UUID'
    for value in "${allowed_client_uuids[@]}"; do [[ "$value" == "$normalized" ]] && existing=1; done
    ((existing)) || allowed_client_uuids+=("$normalized")
  done <"$source"
}

load_settings() {
  local selected
  selected=$(read_desktop_user "$settings_file") || fail "missing settings: $settings_file"
  read_allowed_clients "$settings_file"
  ((${#allowed_client_uuids[@]} > 0)) || fail 'machine settings do not allow a pre-login client'
  resolve_desktop_identity "$selected"
}

write_settings() {
  local requested_user=$1 temporary uuid normalized existing; shift
  require_root configure; resolve_desktop_identity "$requested_user"; /usr/bin/install -d -o root -g root -m 0755 /etc/vibepollo
  allowed_client_uuids=()
  for uuid in "$@"; do
    normalized=${uuid^^}; existing=0
    [[ "$normalized" =~ ^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$ ]] || fail 'invalid allowed client UUID'
    for uuid in "${allowed_client_uuids[@]}"; do [[ "$uuid" == "$normalized" ]] && existing=1; done
    ((existing)) || allowed_client_uuids+=("$normalized")
  done
  ((${#allowed_client_uuids[@]} > 0)) || fail 'at least one pre-login client UUID is required'
  temporary=$(/usr/bin/mktemp --tmpdir=/etc/vibepollo .machine.XXXXXX)
  /usr/bin/printf 'desktop_user=%s\n' "$desktop_user" >"$temporary"
  for uuid in "${allowed_client_uuids[@]}"; do /usr/bin/printf 'allowed_client_uuid=%s\n' "$uuid" >>"$temporary"; done
  /usr/bin/chown root:root "$temporary"; /usr/bin/chmod 0600 "$temporary"; /usr/bin/mv -fT -- "$temporary" "$settings_file"
}

authorize_commands() {
  local source temporary extracted
  require_root authorize-commands; load_settings
  temporary=$(/usr/bin/mktemp --tmpdir=/etc/vibepollo .commands.XXXXXX)
  extracted=$(/usr/bin/mktemp --tmpdir=/etc/vibepollo .commands-json.XXXXXX)
  for source in "$machine_profile/apps.json" /usr/share/vibepollo/prelogin/apps.json; do
    [[ -f "$source" && ! -L "$source" ]] || { /usr/bin/rm -f -- "$temporary" "$extracted"; fail "unsafe application list: $source"; }
    if ! /usr/bin/jq -er '
        [.apps[]? | [(.cmd? // empty), (.detached[]? // empty), (."prep-cmd"[]? | (.do? // empty), (.undo? // empty))][]
          | select(type == "string" and length > 0)] as $commands
        | if any($commands[]; test("[\\r\\n]")) then error("command contains a line break") else $commands[] end
      ' "$source" >"$extracted"; then
      /usr/bin/rm -f -- "$temporary" "$extracted"; fail "invalid application commands: $source"
    fi
    /usr/bin/cat "$extracted" >>"$temporary"
  done
  /usr/bin/rm -f -- "$extracted"
  LC_ALL=C /usr/bin/sort -u -o "$temporary" "$temporary"
  [[ -s "$temporary" ]] || { /usr/bin/rm -f -- "$temporary"; fail 'application command authorization is empty'; }
  /usr/bin/chown root:"$service_user" "$temporary"; /usr/bin/chmod 0640 "$temporary"; /usr/bin/mv -fT -- "$temporary" "$command_manifest"
}

profile_is_safe() {
  local unsafe
  [[ -d "$1" && ! -L "$1" ]] || return 1
  unsafe=$(/usr/bin/find "$1" -mindepth 1 ! -type d ! -type f -print -quit)
  [[ -z "$unsafe" ]] || fail "profile contains an unsupported object: $unsafe"
}

secure_machine_profile() {
  /usr/bin/chown "$service_user:$service_user" "$machine_profile"; /usr/bin/chmod 0700 "$machine_profile"
  /usr/bin/find "$machine_profile" -mindepth 1 -type d -exec /usr/bin/chown "$service_user:$service_user" '{}' +
  /usr/bin/find "$machine_profile" -mindepth 1 -type d -exec /usr/bin/chmod 0700 '{}' +
  /usr/bin/find "$machine_profile" -mindepth 1 -type f -exec /usr/bin/chown "$service_user:$service_user" '{}' +
  /usr/bin/find "$machine_profile" -mindepth 1 -type f -exec /usr/bin/chmod 0600 '{}' +
}

migrate_profile() {
  local source staging
  require_root migrate-profile; load_settings; /usr/bin/getent passwd "$service_user" >/dev/null || fail "missing system account: $service_user"
  /usr/bin/install -d -o "$service_user" -g "$service_user" -m 0700 "$machine_profile"
  /usr/bin/install -d -o root -g root -m 0755 "$runtime_root"
  if [[ -f "$profile_marker" && ! -L "$profile_marker" ]]; then profile_is_safe "$machine_profile"; secure_machine_profile; return; fi
  [[ ! -e "$profile_marker" && ! -L "$profile_marker" ]] || fail 'unsafe machine-profile marker'
  source=$desktop_home/.config/vibepollo; profile_is_safe "$source" || fail "missing or unsafe source profile: $source"
  /usr/bin/find "$machine_profile" -mindepth 1 -print -quit | /usr/bin/grep -q . && fail 'machine profile is non-empty without its marker'
  staging=$(/usr/bin/mktemp -d --tmpdir="$runtime_root" .profile.XXXXXX)
  /usr/bin/cp -a --no-preserve=ownership -- "$source/." "$staging/" || { /usr/bin/rm -rf -- "$staging"; fail 'profile staging failed'; }
  profile_is_safe "$staging" || { /usr/bin/rm -rf -- "$staging"; return 1; }
  /usr/bin/cp -a --no-preserve=ownership -- "$staging/." "$machine_profile/"; /usr/bin/rm -rf -- "$staging"
  /usr/bin/printf 'source_user=%s\n' "$desktop_user" >"$profile_marker"; secure_machine_profile
  /usr/bin/printf 'vibepollo-machine-host: migrated %s into the machine profile\n' "$source"
}

configure_automatically() {
  local home selected state user uid; local -a candidates=() clients=()
  require_root configure-auto
  if [[ -f "$settings_file" && ! -L "$settings_file" ]]; then
    selected=$(read_desktop_user "$settings_file"); read_allowed_clients "$settings_file"; clients=("${allowed_client_uuids[@]}")
    if ((${#clients[@]} == 0)); then
      [[ -f "$legacy_settings_file" && ! -L "$legacy_settings_file" ]] || fail 'existing machine settings need an allowed client UUID'
      read_allowed_clients "$legacy_settings_file"; clients=("${allowed_client_uuids[@]}"); write_settings "$selected" "${clients[@]}"
    fi
    load_settings; migrate_profile; authorize_commands; return
  fi
  if [[ -f "$legacy_settings_file" && ! -L "$legacy_settings_file" ]]; then
    selected=$(read_desktop_user "$legacy_settings_file"); read_allowed_clients "$legacy_settings_file"; clients=("${allowed_client_uuids[@]}")
  else
    while IFS=: read -r user _ uid _ _ home _; do
      [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 && "$home" == /* && -d "$home" && ! -L "$home" ]] || continue
      for state in "$home/.config/vibepollo/vibeshine_state.json" "$home/.config/vibepollo/sunshine_state.json"; do
        if user_exec "$user" /usr/bin/test -f "$state" && ! user_exec "$user" /usr/bin/test -L "$state"; then
          candidates+=("$user")
          break
        fi
      done
    done < <(/usr/bin/getent passwd)
    ((${#candidates[@]} == 1)) || fail 'automatic setup requires exactly one desktop Vibepollo profile'; selected=${candidates[0]}
  fi
  ((${#clients[@]} > 0)) || fail 'automatic setup requires an explicit pre-login client UUID'
  write_settings "$selected" "${clients[@]}"; migrate_profile; authorize_commands
}

prepare_nvidia_devices() {
  local found=0 information minor node
  [[ -d /sys/module/nvidia ]] || return 0; [[ -x /usr/bin/nvidia-modprobe ]] || fail 'nvidia-modprobe is unavailable'
  for information in /proc/driver/nvidia/gpus/*/information; do
    [[ -f "$information" && ! -L "$information" ]] || continue; minor=$(/usr/bin/sed -n 's/^Device Minor:[[:space:]]*//p' "$information")
    [[ "$minor" =~ ^(0|[1-9][0-9]*)$ ]] || fail "invalid NVIDIA minor in $information"; /usr/bin/nvidia-modprobe -c "$minor"; found=1
  done
  ((found)) || fail 'NVIDIA GPU metadata is unavailable'; /usr/bin/nvidia-modprobe -m; /usr/bin/nvidia-modprobe -u
  for node in /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia-uvm; do [[ -c "$node" && ! -L "$node" ]] || fail "missing $node"; done
}

user_exec() {
  local user=$1 uid gid; shift; uid=$(/usr/bin/id -u -- "$user"); gid=$(/usr/bin/id -g -- "$user")
  /usr/bin/setpriv --reuid "$uid" --regid "$gid" --init-groups --no-new-privs -- "$@"
}

user_systemctl() {
  local user=$1 uid gid runtime; shift; uid=$(/usr/bin/id -u -- "$user"); gid=$(/usr/bin/id -g -- "$user"); runtime=/run/user/$uid; [[ -S "$runtime/bus" ]] || return 1
  /usr/bin/timeout --signal=KILL 25 /usr/bin/setpriv --reuid "$uid" --regid "$gid" --init-groups --no-new-privs -- /usr/bin/env -i \
    "XDG_RUNTIME_DIR=$runtime" "DBUS_SESSION_BUS_ADDRESS=unix:path=$runtime/bus" /usr/bin/systemctl --user "$@"
}

discover_wayland_display() {
  local user=$1 candidate display runtime selected=''; runtime=/run/user/$(/usr/bin/id -u -- "$user")
  display=$(user_systemctl "$user" show-environment 2>/dev/null | /usr/bin/sed -n 's/^WAYLAND_DISPLAY=//p' | /usr/bin/head -n1) || :
  [[ "$display" =~ ^wayland-[0-9]+$ && -S "$runtime/$display" ]] && { /usr/bin/printf '%s\n' "$display"; return; }
  for candidate in "$runtime"/wayland-*; do [[ -S "$candidate" ]] || continue; display=${candidate##*/}; [[ "$display" =~ ^wayland-[0-9]+$ ]] || continue; [[ -z "$selected" ]] || fail "multiple Wayland displays for $user"; selected=$display; done
  [[ -n "$selected" ]] || fail "Wayland display is not ready for $user"; /usr/bin/printf '%s\n' "$selected"
}

active_handoff_user() {
  local marker attributes; local -a markers fields
  shopt -s nullglob; markers=("$handoff_directory"/*); shopt -u nullglob; ((${#markers[@]} <= 1)) || fail 'multiple handoffs exist'; ((${#markers[@]} == 1)) || return 1
  marker=${markers[0]}; [[ -f "$marker" && ! -L "$marker" ]] || fail 'unsafe handoff marker'; attributes=$(/usr/bin/stat -c '%U:%G:%a:%F' -- "$marker")
  [[ "$attributes" == 'root:root:600:regular file' ]] || fail 'untrusted handoff marker'; mapfile -t fields <"$marker"
  [[ ${#fields[@]} == 3 && ${fields[1]} == "${marker##*/}" ]] || fail 'invalid handoff marker'; resolve_desktop_identity "${fields[0]}"; [[ "$desktop_uid" == "${fields[1]}" ]] || fail 'handoff mismatch'
  /usr/bin/printf '%s\n' "$desktop_user"
}

wait_for_session() {
  local user=$1 target=$2 attempt
  /usr/bin/systemctl start "user@$(/usr/bin/id -u -- "$user").service"; user_systemctl "$user" reset-failed "$target" >/dev/null 2>&1 || :
  for ((attempt=0; attempt<240; ++attempt)); do user_systemctl "$user" start "$target" >/dev/null 2>&1 && discover_wayland_display "$user" >/dev/null 2>&1 && return; /usr/bin/sleep 0.25; done
  fail "graphical session did not become ready for $user"
}

write_session() {
  local user=$1 role=$2 entry uid gid home runtime display xdisplay groups allowed temporary old_uid
  entry=$(/usr/bin/getent passwd "$user"); IFS=: read -r _ _ uid gid _ home _ <<<"$entry"; runtime=/run/user/$uid; display=$(discover_wayland_display "$user")
  xdisplay=$(user_systemctl "$user" show-environment 2>/dev/null | /usr/bin/sed -n 's/^DISPLAY=//p' | /usr/bin/head -n1) || :
  [[ "$xdisplay" =~ ^:[0-9]+$ ]] || xdisplay=''
  allowed=$(IFS=,; /usr/bin/printf '%s' "${allowed_client_uuids[*]}")
  groups=$(/usr/bin/id -G -- "$user" | /usr/bin/tr ' ' ',')
  if [[ -f "$acl_state" && ! -L "$acl_state" ]]; then read -r old_uid <"$acl_state" || :; [[ "$old_uid" =~ ^[0-9]+$ ]] && /usr/bin/setfacl -x "u:$service_user" "/run/user/$old_uid" 2>/dev/null || :; fi
  /usr/bin/setfacl -m "u:$service_user:--x" "$runtime"
  temporary=$(/usr/bin/mktemp --tmpdir="$runtime_root" .session.XXXXXX)
  /usr/bin/printf 'user=%s\nuid=%s\ngid=%s\nhome=%s\nruntime=%s\ndisplay=%s\nxdisplay=%s\ngroups=%s\nrole=%s\nallowed_clients=%s\n' "$user" "$uid" "$gid" "$home" "$runtime" "$display" "$xdisplay" "$groups" "$role" "$allowed" >"$temporary"
  /usr/bin/chown root:"$service_user" "$temporary"; /usr/bin/chmod 0640 "$temporary"; /usr/bin/mv -fT -- "$temporary" "$session_file"
  /usr/bin/printf '%s\n' "$uid" >"$acl_state"; /usr/bin/chown root:root "$acl_state"; /usr/bin/chmod 0600 "$acl_state"
}

prepare() {
  local selected
  require_root prepare; load_settings; migrate_profile; prepare_nvidia_devices
  if selected=$(active_handoff_user); then wait_for_session "$selected" plasma-kwin_wayland.service; write_session "$selected" desktop
  else /usr/bin/getent passwd "$greeter_user" >/dev/null; wait_for_session "$greeter_user" plasma-login-wayland.target; write_session "$greeter_user" greeter; fi
}

load_session() {
  local attributes key value line
  [[ -f "$session_file" && ! -L "$session_file" ]] || fail 'missing session environment'; attributes=$(/usr/bin/stat -c '%U:%G:%a:%F' -- "$session_file")
  [[ "$attributes" == "root:${service_user}:640:regular file" ]] || fail 'untrusted session environment'
  while IFS= read -r line || [[ -n "$line" ]]; do key=${line%%=*}; value=${line#*=}; case "$key" in user) session_user=$value;; uid) session_uid=$value;; gid) session_gid=$value;; home) session_home=$value;; runtime) session_runtime=$value;; display) session_display=$value;; xdisplay) session_xdisplay=$value;; groups) session_groups=$value;; role) session_role=$value;; allowed_clients) session_allowed_clients=$value;; *) fail "unknown session key: $key";; esac; done <"$session_file"
  valid_user "$session_user"; [[ "$session_uid" =~ ^[0-9]+$ && "$session_gid" =~ ^[0-9]+$ && "$session_home" == /* && "$session_runtime" == "/run/user/$session_uid" && "$session_display" =~ ^wayland-[0-9]+$ && ( -z "$session_xdisplay" || "$session_xdisplay" =~ ^:[0-9]+$ ) && "$session_groups" =~ ^[0-9]+(,[0-9]+)*$ && "$session_role" =~ ^(desktop|greeter)$ && "$session_allowed_clients" =~ ^[0-9A-F-]+(,[0-9A-F-]+)*$ ]] || fail 'invalid session environment'
}

run_host() {
  local -a overrides=('system_tray=disabled')
  [[ $(/usr/bin/id -un) == "$service_user" ]] || fail "run requires $service_user"; load_session
  if [[ "$session_role" == greeter ]]; then overrides+=('encoder=nvenc_experimental' 'capture=kms' 'min_log_level=info' 'virtual_display_mode=shared' 'virtual_display_layout=exclusive' 'dd_config_revert_on_disconnect=enabled' 'dd_config_revert_delay=0' 'origin_web_ui_allowed=pc' 'session_history_enabled=disabled' 'frame_limiter_enable=false' 'file_apps=/usr/share/vibepollo/prelogin/apps.json' 'log_path=/var/lib/vibepollo/logs/prelogin.log'); fi
  exec /usr/bin/env -i "HOME=$session_home" "USER=$service_user" "LOGNAME=$service_user" "PATH=/usr/local/sbin:/usr/local/bin:/usr/bin" \
    "XDG_CONFIG_HOME=/var/lib" "XDG_RUNTIME_DIR=$session_runtime" "PIPEWIRE_RUNTIME_DIR=$session_runtime" "XDG_SESSION_TYPE=wayland" "WAYLAND_DISPLAY=$session_display" \
    "DBUS_SESSION_BUS_ADDRESS=unix:path=$session_runtime/bus" "VIBEPOLLO_MACHINE_HOST=1" "VIBEPOLLO_ALLOWED_CLIENT_UUIDS=$session_allowed_clients" \
    "VIBEPOLLO_SESSION_ROLE=$session_role" "VIBEPOLLO_SESSION_UID=$session_uid" "VIBEPOLLO_SESSION_GID=$session_gid" "VIBEPOLLO_SESSION_GROUPS=$session_groups" \
    /usr/bin/vibepollo "$machine_profile/vibepollo.conf" "${overrides[@]}"
}

cleanup() {
  local old_uid old_user old_gid attributes
  require_root cleanup
  if [[ -f "$acl_state" && ! -L "$acl_state" ]]; then
    attributes=$(/usr/bin/stat -c '%U:%G:%a:%F' -- "$acl_state")
    [[ "$attributes" == 'root:root:600:regular file' ]] || fail 'untrusted runtime ACL state'
    read -r old_uid <"$acl_state" || :
    [[ "$old_uid" =~ ^[0-9]+$ ]] || fail 'invalid runtime ACL state'
    old_user=$(/usr/bin/id -nu -- "$old_uid") || fail 'runtime ACL owner no longer exists'
    old_gid=$(/usr/bin/id -g -- "$old_user")
    /usr/bin/setpriv --reuid "$old_uid" --regid "$old_gid" --init-groups --no-new-privs -- /usr/bin/setfacl -x "u:$service_user" "/run/user/$old_uid" 2>/dev/null || :
    /usr/bin/rm -f -- "$acl_state"
  fi
  [[ ! -e "$session_file" || (-f "$session_file" && ! -L "$session_file") ]] || fail 'unsafe session environment'
  /usr/bin/rm -f -- "$session_file"
}

activate_greeter() {
  local configuration; [[ $(/usr/bin/id -un) == "$greeter_user" ]] || fail "activate requires $greeter_user"
  for ((attempt=0; attempt<100; ++attempt)); do if configuration=$(/usr/bin/kscreen-doctor -j 2>/dev/null) && /usr/bin/jq -e --arg name "$virtual_output" '([.outputs[] | select(.connected and .enabled)] | length) == 1 and any(.outputs[]; .name == $name and .connected and .enabled)' >/dev/null <<<"$configuration"; then /usr/bin/systemctl --user restart plasma-login.service; return; fi; /usr/bin/sleep 0.1; done
  fail "refusing greeter start without exclusive $virtual_output"
}

install_pam_hook() {
  local temporary; require_root install-pam; [[ -f "$pam_file" && ! -L "$pam_file" ]] || fail "unsafe PAM policy: $pam_file"
  /usr/bin/grep -Eq '^[[:space:]]*session[[:space:]]+optional[[:space:]]+pam_vibepollo_session\.so([[:space:]]|$)' "$pam_file" && return
  [[ $(/usr/bin/stat -c '%U:%G' -- "$pam_file") == root:root ]] || fail 'PAM policy is not root-owned'; temporary=$(/usr/bin/mktemp --tmpdir=/etc/pam.d .plasmalogin.XXXXXX)
  /usr/bin/awk -v hook="$pam_line" '!done && $1=="session" && $2=="include" && $3=="system-login" {print hook; done=1} {print} END {if (!done) exit 1}' "$pam_file" >"$temporary" || { /usr/bin/rm -f -- "$temporary"; fail 'PAM insertion point missing'; }
  /usr/bin/chown --reference="$pam_file" "$temporary"; /usr/bin/chmod --reference="$pam_file" "$temporary"; /usr/bin/mv -fT -- "$temporary" "$pam_file"
}

remove_pam_hook() {
  local temporary; require_root remove-pam; [[ -f "$pam_file" && ! -L "$pam_file" ]] || return 0; temporary=$(/usr/bin/mktemp --tmpdir=/etc/pam.d .plasmalogin.XXXXXX)
  /usr/bin/awk '$1=="session" && $2=="optional" && $3=="pam_vibepollo_session.so" {next} {print}' "$pam_file" >"$temporary"; /usr/bin/chown --reference="$pam_file" "$temporary"; /usr/bin/chmod --reference="$pam_file" "$temporary"; /usr/bin/mv -fT -- "$temporary" "$pam_file"
}

case "${1:-}" in
  configure) [[ $# -ge 3 ]] || exit 2; shift; write_settings "$@"; migrate_profile; authorize_commands;; configure-auto) [[ $# == 1 ]] || exit 2; configure_automatically;; authorize-commands) [[ $# == 1 ]] || exit 2; authorize_commands;; migrate-profile) [[ $# == 1 ]] || exit 2; migrate_profile;; prepare) [[ $# == 1 ]] || exit 2; prepare;; run) [[ $# == 1 ]] || exit 2; run_host;; cleanup) [[ $# == 1 ]] || exit 2; cleanup;; activate) [[ $# == 1 ]] || exit 2; activate_greeter;; install-pam) [[ $# == 1 ]] || exit 2; install_pam_hook;; remove-pam) [[ $# == 1 ]] || exit 2; remove_pam_hook;; *) /usr/bin/printf 'usage: %s {configure USER CLIENT_UUID...|configure-auto|authorize-commands|migrate-profile|prepare|run|cleanup|activate|install-pam|remove-pam}\n' "$0" >&2; exit 2;;
esac
