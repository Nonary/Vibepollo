<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@PROJECT_FQDN@</id>

  <name>@PROJECT_NAME@</name>
  <summary>@PROJECT_BRIEF_DESCRIPTION@</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@PROJECT_LICENSE@</project_license>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>gamepad</control>
  </supports>

  <url type="homepage">@PROJECT_HOMEPAGE_URL@</url>
  <url type="bugtracker">https://github.com/Nonary/Vibepollo/issues</url>
  <url type="faq">https://github.com/Nonary/Vibepollo/blob/master/docs/troubleshooting.md</url>
  <url type="help">https://github.com/Nonary/Vibepollo/tree/master/docs</url>
  <url type="contact">https://github.com/Nonary/Vibepollo/discussions</url>

  <description>
    <p>@PROJECT_LONG_DESCRIPTION@</p>

    <p>NOTE: Vibepollo requires additional installation steps on Flatpak.</p>
    <p>
      <code>flatpak run --command=additional-install.sh @PROJECT_FQDN@</code>
    </p>
    <p>NOTE: Vibepollo uses a self-signed certificate. The web browser will report it as not secure, but it is safe.</p>
  </description>

  <releases>
    <release version="@PROJECT_VERSION@" date="@PROJECT_YEAR@-@PROJECT_MONTH@-@PROJECT_DAY@">
      <url>https://github.com/Nonary/Vibepollo/releases/tag/@PROJECT_VERSION_FULL@</url>
      <description>
        <p>See the changelog on GitHub</p>
      </description>
    </release>
  </releases>

  <developer id="io.github.nonary">
    <name>Nonary</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Nonary/Vibepollo/master/gh-pages-template/assets/img/screenshots/01-sunshine-welcome-page.png</image>
      <caption>Vibepollo welcome page</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.0">
    <content_attribute id="language-profanity">moderate</content_attribute>
    <content_attribute id="language-humor">mild</content_attribute>
    <content_attribute id="money-purchasing">mild</content_attribute>
  </content_rating>
  <launchable type="desktop-id">@PROJECT_FQDN@.desktop</launchable>
</component>
