[Unit]
Description=Vibepollo shared display for the Plasma login screen
Documentation=https://github.com/Nonary/Vibepollo
Wants=vibeshine-vkms.service
After=vibeshine-vkms.service display-manager.service
ConditionPathExists=/etc/vibepollo/prelogin.conf
StartLimitIntervalSec=0

[Service]
Type=simple
User=plasmalogin
Group=plasmalogin
SupplementaryGroups=video render input vibeshine-vkms
StateDirectory=vibepollo-prelogin
StateDirectoryMode=0750
Environment=HOME=/var/lib/plasmalogin
Environment=XDG_CONFIG_HOME=/var/lib/vibepollo-prelogin
Environment=XDG_SESSION_TYPE=wayland
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_NICE
ExecStartPre=+/usr/libexec/vibeshine/vibepollo-session-handoff wait-prelogin
ExecStartPre=+/usr/libexec/vibeshine/vibepollo-prelogin-sync prepare
ExecStart=/usr/libexec/vibeshine/vibepollo-prelogin-sync run
Restart=on-failure
RestartSec=3
RestartSteps=7
RestartMaxDelaySec=5min
TimeoutStartSec=infinity
TimeoutStopSec=20
UMask=0077
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidia-modeset rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-nvidia-caps r
DeviceAllow=/dev/uinput rw
DeviceAllow=/dev/uhid rw
ProtectSystem=strict
ReadWritePaths=/var/lib/vibepollo-prelogin /var/lib/vibepollo-prelogin-static
ProtectHome=read-only
PrivateTmp=yes
PrivateMounts=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=graphical.target
