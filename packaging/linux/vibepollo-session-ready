#!/usr/bin/bash

set -euo pipefail

readonly handoff_helper=/usr/libexec/vibeshine/vibepollo-session-handoff
readonly handoff_marker=/run/vibepollo/prelogin-handoff-complete
readonly maximum_delay=5

should_log_attempt() {
  local attempt=$1
  ((attempt == 0 || (attempt & (attempt - 1)) == 0))
}

manager_environment_value() {
  local name=$1
  /usr/bin/systemctl --user show-environment |
    /usr/bin/sed -n "s/^${name}=//p" |
    /usr/bin/head -n 1
}

discover_wayland_display() {
  local candidate name selected=''
  for candidate in "${XDG_RUNTIME_DIR}"/wayland-*; do
    [[ -S "$candidate" ]] || continue
    name=${candidate##*/}
    [[ "$name" =~ ^wayland-[0-9]+$ ]] || continue
    [[ -z "$selected" ]] || return 1
    selected=$name
  done
  [[ -n "$selected" ]] || return 1
  /usr/bin/printf '%s\n' "$selected"
}

desktop_is_ready() {
  local wayland_display
  /usr/bin/systemctl --user is-active --quiet plasma-kwin_wayland.service || return 1

  wayland_display=$(manager_environment_value WAYLAND_DISPLAY)
  if [[ -z "$wayland_display" ]]; then
    wayland_display=$(discover_wayland_display) || return 1
    /usr/bin/systemctl --user set-environment "WAYLAND_DISPLAY=$wayland_display"
  fi
  [[ "$wayland_display" =~ ^wayland-[0-9]+$ ]] || return 1
  [[ -S "${XDG_RUNTIME_DIR}/${wayland_display}" ]] || return 1

  /usr/bin/timeout --signal=KILL 5 \
    /usr/bin/env "WAYLAND_DISPLAY=$wayland_display" /usr/bin/kscreen-doctor -j >/dev/null 2>&1
}

kwin_service_is_installed() {
  [[ $(/usr/bin/systemctl --user show plasma-kwin_wayland.service \
        --property=LoadState --value 2>/dev/null) == loaded ]]
}

main() {
  local attempt=0 delay=1

  if [[ "${VIBEPOLLO_REQUIRE_PRELOGIN_HANDOFF:-0}" == 1 || -e "$handoff_marker" ]]; then
    [[ -x "$handoff_helper" ]] || {
      /usr/bin/printf 'vibepollo-session-ready: missing handoff helper: %s\n' "$handoff_helper" >&2
      return 1
    }
    "$handoff_helper" verify
  fi

  # Other compositors retain their existing startup behavior. Plasma hosts get
  # a state-driven readiness gate instead of a guessed fixed delay.
  if ! kwin_service_is_installed; then
    return 0
  fi

  while ! desktop_is_ready; do
    if should_log_attempt "$attempt"; then
      /usr/bin/printf 'vibepollo-session-ready: waiting for a usable KWin/Wayland display (attempt %d)\n' "$((attempt + 1))" >&2
    fi
    /usr/bin/sleep "$delay"
    ((attempt += 1))
    if ((delay < maximum_delay)); then
      ((delay *= 2))
      ((delay > maximum_delay)) && delay=$maximum_delay
    fi
  done

  /usr/bin/printf 'vibepollo-session-ready: desktop capture prerequisites are ready\n'
}

main "$@"
