@VIBEPOLLO_BASE_POSTINST@

# Build/register the optional HDR virtual-display module. Failure is not fatal:
# vibepollo-vkms will retry at boot and can use upstream VKMS as an SDR fallback.
if [ -x "@VIBEPOLLO_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibepollo-drm-install" ]; then
  echo "Installing the Vibepollo HDR DRM module."
  "@VIBEPOLLO_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibepollo-drm-install" install || \
    echo "warning: Vibepollo HDR DRM installation failed; upstream VKMS fallback remains available."
fi
