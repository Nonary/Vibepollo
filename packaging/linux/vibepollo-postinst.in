@VIBESHINE_BASE_POSTINST@

# Build/register the optional HDR virtual-display module. Failure is not fatal:
# The libvirtualdisplay pool helper will retry at boot and can use upstream VKMS as an SDR fallback.
if [ -x "@VIBESHINE_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibeshine-drm-install" ]; then
  echo "Installing the Vibepollo HDR DRM module."
  "@VIBESHINE_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibeshine-drm-install" install || \
    echo "warning: Vibepollo HDR DRM installation failed; upstream VKMS fallback remains available."
fi
