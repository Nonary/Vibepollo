[Unit]
Description=Vibepollo machine streaming host
Documentation=https://github.com/Nonary/Vibepollo
# The controller owns ordered cleanup through ExecStopPost. Binding this unit
# directly to the controller would queue a concurrent stop and bypass that
# close-admission, drain-host, drain-broker sequence.
Requires=vibepollo-session-exec.socket
Wants=vibeshine-vkms.service
After=vibepollo-session-controller.service vibepollo-session-exec.socket vibeshine-vkms.service
ConditionPathExists=/run/vibepollo/session.env
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
User=vibepollo
Group=vibepollo
SupplementaryGroups=video render vibepollo-uinput vibeshine-vkms
StateDirectory=vibepollo
StateDirectoryMode=0700
RuntimeDirectory=vibepollo/host
RuntimeDirectoryMode=0700
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_NICE
AmbientCapabilities=
# The capability-free supervisor must be able to exec the private +p host.
# The host enters with E/I/A empty and sets NoNewPrivileges in the literal
# first Linux statement of main(), before configuration or logging.
NoNewPrivileges=no
ExecStart=/usr/libexec/vibeshine/vibepollo-machine-host run
Restart=no
KillMode=control-group
# A stuck GPU teardown must leave this unit deactivating and block rebinding;
# killing the process tree would strand imported DRM/NVENC resources.
SendSIGKILL=no
TimeoutStartSec=45
TimeoutStopSec=20
MemoryMax=2G
TasksMax=512
UMask=0077
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidia-modeset rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-nvidia-caps r
DeviceAllow=/dev/uinput rw
DeviceAllow=/dev/uhid rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
