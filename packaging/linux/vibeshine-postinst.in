@VIBESHINE_BASE_POSTINST@

# Build/register the managed virtual-display module. Package installation may
# continue on failure, but managed displays remain unavailable until it loads.
if [ -x "@VIBESHINE_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibeshine-drm-install" ]; then
  echo "Installing the Vibeshine HDR DRM module."
  "@VIBESHINE_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibeshine-drm-install" install || \
    echo "warning: Vibeshine DRM installation failed; managed virtual displays are unavailable."
fi
