<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>SunshinePlaynite</AssemblyName>
    <RootNamespace>SunshinePlaynite</RootNamespace>
    <Version>0.5.0</Version>
    <LangVersion>7.3</LangVersion>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.15.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../src_assets/common/assets/web/public/images/logo-sunshine-45.png"
          Link="icon.png"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
