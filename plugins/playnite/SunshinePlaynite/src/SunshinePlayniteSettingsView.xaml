<UserControl x:Class="SunshinePlaynite.SunshinePlayniteSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,6,24,20">
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="{Binding SettingsTitle, Mode=OneTime}" />
            <TextBlock Margin="0,5,0,18"
                       Opacity="0.72"
                       Text="Control how Playnite communicates with Vibeshine on this computer."
                       TextWrapping="Wrap" />

            <TextBlock FontWeight="SemiBold" Text="Connector" />
            <CheckBox Margin="0,10,0,0"
                      Content="Enable the connector"
                      IsChecked="{Binding ConnectorEnabled}" />
            <TextBlock Margin="24,3,0,10"
                       Opacity="0.68"
                       Text="Accept local Vibeshine connections and report game activity."
                       TextWrapping="Wrap" />

            <CheckBox Content="Notify Vibeshine when the Playnite library changes"
                      IsChecked="{Binding NotifyLibraryChanges}" />
            <TextBlock Margin="24,3,0,10"
                       Opacity="0.68"
                       Text="Send an updated library snapshot after games or metadata change. Vibeshine controls which games are imported."
                       TextWrapping="Wrap" />

            <Separator Margin="0,10,0,16" />

            <TextBlock FontWeight="SemiBold" Text="Diagnostics" />
            <CheckBox Margin="0,10,0,0"
                      Content="Enable verbose connector logging"
                      IsChecked="{Binding EnableDebugLogging}" />
            <TextBlock Margin="24,3,0,10"
                       Opacity="0.68"
                       Text="Write additional diagnostic messages to the Sunshine log folder. Enable this only while troubleshooting."
                       TextWrapping="Wrap" />

            <Border Margin="0,12,0,0"
                    Padding="12"
                    BorderBrush="#407F8C8D"
                    BorderThickness="1"
                    CornerRadius="3">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Connection details" />
                    <TextBlock Margin="0,5,0,0"
                               Opacity="0.72"
                               Text="Vibeshine connects automatically over the local Sunshine.PlayniteExtension named pipe. No address, port, or credentials are required."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
