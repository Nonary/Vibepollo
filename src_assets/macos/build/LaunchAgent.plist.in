<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Open at Login: registered from the menu bar with SMAppService, which requires this file in
  Contents/Library/LaunchAgents. launchd starts Vibepollo at login and restarts it if it crashes,
  but not after it quits normally (exit status 0).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@PROJECT_FQDN@</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/@CMAKE_PROJECT_NAME@</string>
  <key>AssociatedBundleIdentifiers</key>
  <string>@PROJECT_FQDN@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
