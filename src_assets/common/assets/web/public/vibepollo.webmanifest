{
  "id": "/stream",
  "name": "Vibepollo Browser Stream",
  "short_name": "Vibepollo",
  "description": "Low-latency remote streaming from Vibepollo",
  "start_url": "/stream",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#090b10",
  "theme_color": "#0f1115",
  "orientation": "any",
  "icons": [
    {
      "src": "/images/apollo.ico",
      "sizes": "any",
      "type": "image/x-icon"
    }
  ]
}
