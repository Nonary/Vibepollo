struct counted_encoder: amf::amf_d3d11 {
  using amf::amf_d3d11::amf_d3d11;
  int encode_calls = 0;

  amf::amf_encode_result encode_frame(uint64_t index, bool idr) {
    ++encode_calls;
    return amf::amf_d3d11::encode_frame(index, idr);
  }
};

struct runtime {
  ID3D11Device device;
  counted_encoder encoder {&device};
  std::chrono::nanoseconds delay = 6600us;
  std::vector<uint64_t> accepted, delivered;
  std::vector<uint8_t> accepted_pixels;
  std::size_t maximum_depth = 0;
  int submit_result = AMF_OK;

  runtime() {
    model_clock::now_ = {};
    events.clear();
    encoder.context = std::make_shared<amf::AMFContext>();
    encoder.encoder = std::make_shared<amf::AMFComponent>();
    encoder.low_latency_pipeline_depth = 0;
    encoder.encoder->submit = [this](auto s) {
      auto id = s->index;
      auto pixels = s->texture->pixels;
      auto idr = s->idr;
      accepted.push_back(id);
      accepted_pixels.push_back(pixels);
      maximum_depth = std::max(maximum_depth, encoder.accepted_input_count - encoder.completed_output_count + 1);
      events.push_back({model_clock::now() + delay, [this, id, pixels, idr] {
                          std::lock_guard lock(encoder.state_mutex);
                          encoder.completed_outputs.push_back({{pixels}, uint64_t(id), idr, encoder.frame_rfi_flags.contains(id), false});
                          ++encoder.completed_output_count;
                          encoder.last_completed_frame_index = id;
                          encoder.last_output_progress = model_clock::now();
                          encoder.input_surfaces_in_flight = 0;
                          for (auto &slot : encoder.input_surface_ring) {
                            if (slot.state == amf::lifecycle::input_surface_state_e::in_flight) {
                              slot.state = amf::lifecycle::input_surface_state_e::free;
                            }
                          }
                        }});
      return submit_result;
    };
  }

  void prepare(uint8_t pixels = 0) {
    for (std::size_t i = 0; i < encoder.active_input_surface_count; i++) {
      if (encoder.input_surface_ring[i].state == amf::lifecycle::input_surface_state_e::free) {
        encoder.input_surface_ring[i].state = amf::lifecycle::input_surface_state_e::reserved;
        encoder.prepared_input_surface_slot = i;
        encoder.input_surface_ring[i].texture->pixels = pixels;
        return;
      }
    }
    assert(false);
  }

  void deliver(amf::amf_encode_result &r) {
    assert(!r.fatal);
    for (auto &f : r.frames) {
      delivered.push_back(f.frame_index);
    }
  }
};

