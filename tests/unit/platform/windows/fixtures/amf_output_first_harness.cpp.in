namespace Microsoft::WRL {
  template<class T>
  struct ComPtr {
    std::shared_ptr<T> p = std::make_shared<T>();

    T *Get() {
      return p.get();
    }

    T *operator->() {
      return p.get();
    }

    operator bool() const {
      return bool(p);
    }

    T **GetAddressOf() {
      static T *value = p.get();
      return &value;
    }

    ComPtr() = default;
    ComPtr(std::nullptr_t):
        p(nullptr) {};
  };
}  // namespace Microsoft::WRL

