// Deterministic AMF/D3D boundary for the production functions extracted by
// test_amf_output_first_retry.py. No vendor runtime or network is involved.
// The fake driver completes after 6.6 ms; captures arrive at 6, 13, 20... ms
// with 1 ms conversion. This puts completion after the real pre-conversion
// output check, exercising the race even with the real capture-wait drain.
#include "src/amf/amf_encoded_frame.h"
#include "src/amf/amf_lifecycle.h"

