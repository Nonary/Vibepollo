struct model_clock {
  using duration = std::chrono::steady_clock::duration;
  using time_point = std::chrono::steady_clock::time_point;
  static inline time_point now_ {};

  static time_point now() {
    return now_;
  }
};

struct event_t {
  model_clock::time_point when;
  std::function<void()> action;
};

std::deque<event_t> events;

void advance(model_clock::time_point end) {
  while (!events.empty() && events.front().when <= end) {
    auto e = events.front();
    events.pop_front();
    model_clock::now_ = e.when;
    e.action();
  }
  model_clock::now_ = std::max(model_clock::now_, end);
}

struct model_cv {
  void notify_all() {}

  template<class Lock, class TP, class Pred>
  bool wait_until(Lock &lock, TP deadline, Pred pred) {
    while (!pred() && model_clock::now() < deadline) {
      auto next = events.empty() ? deadline : std::min(deadline, events.front().when);
      lock.unlock();
      advance(next);
      lock.lock();
    }
    return pred();
  }

  template<class Lock, class Duration, class Pred>
  bool wait_for(Lock &lock, Duration timeout, Pred pred) {
    return wait_until(lock, model_clock::now() + timeout, pred);
  }
};

namespace util {
  template<class F>
  struct guard {
    F f;
    bool active = true;

    ~guard() {
      if (active) {
        f();
      }
    }

    void disable() {
      active = false;
    }
  };

  template<class F>
  auto fail_guard(F f) {
    return guard<F> {f};
  }

  template<class T>
  struct hex_t {
    std::string to_string_view() {
      return "0";
    }
  };

  template<class T>
  auto hex(T) {
    return hex_t<T> {};
  }
}  // namespace util

struct null_log {
  template<class T>
  null_log &operator<<(T const &) {
    return *this;
  }
};

