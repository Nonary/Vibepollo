struct packet_raw_generic {
  packet_raw_generic(std::vector<uint8_t> d, uint64_t i, bool idr):
      data(std::move(d)),
      index(i),
      idr(idr) {}

  std::vector<uint8_t> data;
  uint64_t index;
  bool idr;
  void *channel_data = nullptr;
  bool after_ref_frame_invalidation = false;
  std::optional<model_clock::time_point> frame_timestamp, capture_timestamp, host_processing_timestamp;
  model_clock::time_point packet_enqueue_timestamp;
};

using packet_t = std::unique_ptr<packet_raw_generic>;

namespace safe {
  struct mail_raw_t {
    template<class T>
    struct queue {
      std::vector<T> values;
      std::function<void()> on_raise;

      void raise(T v) {
        values.push_back(std::move(v));
        if (on_raise) {
          on_raise();
        }
      }
    };
    template<class T>
    using queue_t = std::shared_ptr<queue<T>>;
  };
}  // namespace safe

struct amf_encode_session_t {
  struct device_t {
    counted_encoder *amf;
  };

  std::unique_ptr<device_t> device;
  bool force_idr = false, last_input_accepted = false, fresh_conversion_pending = true, suppress_tail_flush_until_fresh_conversion = false;
  std::optional<model_clock::time_point> last_input_accepted_at;
  int64_t last_emitted_index = -1;
#include "video_session_methods.inc"

  struct pending_timestamp_slot_t {
    uint64_t frame_index = 0;
    bool valid = false;
    frame_timestamps_t ts;
  };

  std::array<pending_timestamp_slot_t, 256> pending_timestamps {};
};

#include "video_delivery.inc"

void check(bool ok, const char *msg) {
  if (!ok) {
    std::cerr << "FAIL " << msg << '\n';
    std::exit(1);
  }
  std::cout << "PASS " << msg << '\n';
}

struct image_queue {
  std::deque<model_clock::time_point> arrivals;

  bool peek() {
    return !arrivals.empty() && arrivals.front() <= model_clock::now();
  }

  bool pop(std::chrono::nanoseconds timeout) {
    if (!peek() && !arrivals.empty() && arrivals.front() <= model_clock::now() + timeout) {
      advance(arrivals.front());
    }
    if (!peek()) {
      return false;
    }
    arrivals.pop_front();
    return true;
  }
};

struct profile_result {
  int source_frames = 0, submissions = 0, outputs = 0, skips = 0;
  std::vector<uint64_t> indices;
  std::vector<uint8_t> pixels;
  std::size_t depth = 0;
};

profile_result profile(int count, std::chrono::nanoseconds convert = 1ms) {
  runtime r;
  amf_encode_session_t s;
  s.device = std::make_unique<amf_encode_session_t::device_t>(&r.encoder);
  auto *native_session = &s;
  auto packets = std::make_shared<safe::mail_raw_t::queue<packet_t>>();
  void *channel_data = nullptr;
  uint64_t frame_nr = 1;
  bool native_amf_runtime_failed = false;
  auto deliver_ready_amf_output = [&]() {
    return amf::lifecycle::deliver_ready_output(native_session, [&](auto &frames) {
      deliver_amf_frames(frame_nr, s, frames, packets, channel_data);
    });
  };
  image_queue image_storage;
  auto *images = &image_storage;
  for (int i = 0; i < count; i++) {
    image_storage.arrivals.push_back(model_clock::time_point {} + 6ms + 7ms * i);
  }
  // First accepted input starts at t=0; next captures arrive at 6,13,20,... ms.
  r.prepare(frame_nr);
  encode_amf(frame_nr++, s, packets, channel_data, {}, {}, {});
  auto encode_frame_threshold = 6060606ns;
  int skipped = 0;
  for (int i = 0; i < count; i++) {
    if (!deliver_ready_amf_output()) {
      break;
    }
    std::chrono::nanoseconds max_frametime = 100ms;
    auto image_wait_budget = max_frametime;
#include "capture_wait.inc"
    if (!img) {
      break;
    }
    advance(model_clock::now() + convert);
    r.prepare(frame_nr);
    s.fresh_conversion_pending = true;
    if (encode_amf(frame_nr++, s, packets, channel_data, model_clock::now(), model_clock::now(), model_clock::now())) {
      break;
    }
    if (!s.was_last_input_accepted()) {
      ++skipped;
    }
  }
  advance(model_clock::now() + 100ms);
  auto tail = s.drain_frames(0ms);
  deliver_amf_frames(frame_nr, s, tail.frames, packets, channel_data);
  profile_result out {count + 1, int(r.accepted.size()), int(packets->values.size()), skipped, {}, {}, r.maximum_depth};
  for (auto &p : packets->values) {
    out.indices.push_back(p->index);
    out.pixels.push_back(p->data[0]);
  }
  check(!native_amf_runtime_failed, "exact capture-wait block completes without AMF fatal error");
  return out;
}

struct fixture {
  runtime r;
  amf_encode_session_t session;
  safe::mail_raw_t::queue_t<packet_t> packets = std::make_shared<safe::mail_raw_t::queue<packet_t>>();

  fixture() {
    session.device = std::make_unique<amf_encode_session_t::device_t>(&r.encoder);
  }

  void older_ready() {
    r.prepare(11);
    r.encoder.encode_frame(1, false);
    advance(model_clock::now() + 10ms);
  }

  int encode(uint64_t index) {
    return encode_amf(index, session, packets, nullptr, model_clock::now(), model_clock::now() - 1ms, model_clock::now() - 2ms);
  }
};

int main() {
  auto fixed = profile(100);
  check(fixed.submissions == 101 && fixed.outputs == 101 && fixed.skips == 0, "conversion-completion race submits and delivers all 101 source captures");
  bool identities = true;
  for (std::size_t i = 0; i < fixed.indices.size(); ++i) {
    identities &= fixed.indices[i] == i + 1 && fixed.pixels[i] == i + 1;
  }
  check(identities, "wire indices and actual encoded pixels match every accepted current capture");
  check(fixed.depth == 1, "retry preserves strict depth-one native application queue");
  {
    fixture f;
    f.older_ready();
    f.r.prepare(22);
    f.session.force_idr = true;
    f.r.encoder.rfi_enabled = true;
    f.r.encoder.effective_ltr_slots = 2;
    f.r.encoder.rfi_pending = true;
    auto stamp = model_clock::now();
    int calls = f.r.encoder.encode_calls;
    check(f.encode(2) == 0, "ready-output recovery call succeeds");
    check(f.r.encoder.encode_calls - calls == 2 && f.session.was_last_input_accepted(), "fresh output-first rejection makes exactly one real submission retry");
    advance(model_clock::now() + 10ms);
    auto tail = f.session.drain_frames(0ms);
    deliver_amf_frames(2, f.session, tail.frames, f.packets, nullptr);
    auto &p = *f.packets->values.back();
    check(p.index == 2 && p.data[0] == 22 && p.idr, "retry submits latest pixels with original index and recovery IDR");
    check(p.frame_timestamp == stamp && p.capture_timestamp == stamp - 1ms && p.host_processing_timestamp == stamp - 2ms, "retry preserves all current-frame timestamps");
    check(!f.session.force_idr && !f.r.encoder.rfi_pending && f.r.encoder.ltr_slots_valid[0] && f.r.encoder.ltr_slot_frame_index[0] == 2, "recovery commits only after current input acceptance");
  }
  {
    fixture f;
    f.older_ready();
    f.r.prepare(22);
    f.session.fresh_conversion_pending = false;
    int calls = f.r.encoder.encode_calls;
    check(f.encode(2) == 0 && f.r.encoder.encode_calls - calls == 1 && !f.session.was_last_input_accepted(), "static duplicate output-only delivery never triggers fresh-capture retry");
  }
  {
    fixture f;
    f.r.encoder.accepted_input_count = 1;
    f.r.encoder.low_latency_pipeline_depth = 0;
    f.r.prepare(22);
    int calls = f.r.encoder.encode_calls;
    check(f.encode(2) == 0 && f.r.encoder.encode_calls - calls == 1 && !f.session.was_last_input_accepted(), "empty output under real backpressure is not retried or hidden");
  }
  {
    fixture f;
    f.r.prepare(22);
    int calls = f.r.encoder.encode_calls;
    check(f.encode(2) == 0 && f.r.encoder.encode_calls - calls == 1 && f.session.was_last_input_accepted(), "accepted asynchronous input without output is never resubmitted");
  }
  {
    fixture f;
    f.r.encoder.preanalysis_enabled = true;
    f.r.encoder.preanalysis_lookahead_depth = 1;
    f.r.submit_result = AMF_NEED_MORE_INPUT;
    f.r.prepare(22);
    check(f.encode(2) == 0 && f.r.encoder.encode_calls == 1 && f.session.was_last_input_accepted(), "accepted NEED_MORE_INPUT preserves PA priming and is never retried");
  }
  {
    fixture f;
    f.r.encoder.output_fatal = true;
    f.r.prepare(22);
    check(f.encode(2) == -1 && f.r.encoder.encode_calls == 1 && f.packets->values.empty(), "fatal native failure returns immediately without retry");
  }
  {
    fixture f;
    auto &e = f.r.encoder;
    e.accepted_input_count = 2;
    e.completed_output_count = 1;
    e.completed_outputs.push_back({{11}, 1, false, false, false});
    f.packets->on_raise = [&]() {
      if (e.completed_output_count == 1) {
        e.completed_output_count = 2;
        e.completed_outputs.push_back({{22}, 2, false, false, false});
      }
    };
    f.r.prepare(33);
    int calls = e.encode_calls;
    check(f.encode(3) == 0 && e.encode_calls - calls == 2 && !f.session.was_last_input_accepted() && f.packets->values.size() == 2, "a second racing completion stops after one retry and leaves the real drop visible");
  }
  {
    fixture f;
    f.older_ready();
    f.r.prepare(22);
    f.session.fresh_conversion_pending = false;
    f.session.force_idr = true;
    int calls = f.r.encoder.encode_calls;
    check(f.encode(2) == 0 && f.r.encoder.encode_calls - calls == 1 && f.session.force_idr, "static requested IDR keeps its pending recovery state when the output-first call declines it");
  }
  {
    fixture f;
    f.older_ready();
    auto &e = f.r.encoder;
    e.rfi_enabled = true;
    e.effective_ltr_slots = 2;
    e.rfi_pending = true;
    e.last_rfi_ltr_index = 0;
    e.ltr_slots_valid[0] = true;
    e.ltr_slot_frame_index[0] = 1;
    f.r.prepare(22);
    check(f.encode(2) == 0 && !e.rfi_pending && e.frame_rfi_flags.contains(2) && e.ltr_slots_valid[0] && e.ltr_slot_frame_index[0] == 1, "RFI-only retry commits the original accepted index and preserves its LTR reference");
    advance(model_clock::now() + 10ms);
    auto tail = f.session.drain_frames(0ms);
    deliver_amf_frames(2, f.session, tail.frames, f.packets, nullptr);
    auto &p = *f.packets->values.back();
    check(p.index == 2 && p.data[0] == 22 && !p.idr && p.after_ref_frame_invalidation, "RFI-only recovery packet retains actual pixels and reference-invalidation flag");
  }
  {
    fixture f;
    f.older_ready();
    f.r.prepare(22);
    f.packets->on_raise = [&]() {
      f.r.encoder.output_fatal = true;
    };
    int calls = f.r.encoder.encode_calls;
    check(f.encode(2) == -1 && f.r.encoder.encode_calls - calls == 2 && f.packets->values.size() == 1, "fatal retry ends encoding after delivering the older packet");
  }
  {
    fixture f;
    f.older_ready();
    f.r.prepare(22);
    // Retained wrappers may outlive their completed output. Fill the driver
    // headroom while keeping a separate free texture for the fresh capture.
    auto &e = f.r.encoder;
    e.encoder_input_queue_size = 1;
    e.accepted_input_count = e.completed_output_count = 2;
    e.completed_outputs.push_back({{12}, 2, false, false, false});
    e.last_completed_frame_index = 2;
    e.input_surfaces_in_flight = 2;
    e.input_surface_ring[1].state = e.input_surface_ring[2].state =
      amf::lifecycle::input_surface_state_e::in_flight;
    int calls = f.r.encoder.encode_calls;
    auto before = model_clock::now();
    check(f.encode(2) == 0 && f.r.encoder.encode_calls - calls == 2 && !f.session.was_last_input_accepted() && model_clock::now() - before <= 6ms, "retained driver ownership bounds the retry and preserves the visible rejection");
  }
  {
    fixture f;
    f.r.delay = 1ms;
    f.r.prepare(22);
    check(f.encode(2) == 0 && f.r.encoder.encode_calls == 1 && f.packets->values.size() == 1 && f.session.was_last_input_accepted(), "accepted input with immediately available output is submitted only once");
  }
}
