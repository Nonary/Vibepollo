// Real catalog publication plus production JSON load/recovery control flow and
// migrations. Per-app conversion, monitor-profile checks and OS I/O are seams;
// no service, display or live user files are accessed.
#include "src/process_catalog.h"
#include "src/legacy_generated_app_identities.h"
#include <nlohmann/json.hpp>
#include <algorithm>
#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <optional>
#include <set>
#include <sstream>
#include <stdexcept>
#include <string>
#include <string_view>
using namespace std::literals;
namespace bp = boost_process_shim;
#define BOOST_LOG(level) std::cerr
#define CHECK(condition) do { if (!(condition)) { std::cerr << "check failed: " #condition << "\n"; std::abort(); } } while (false)
namespace file_handler {
  bool fail_write = false;
  int write_attempts = 0;
  std::string read_file(const char *path) {
    std::ifstream in(path, std::ios::binary);
    if (!in) throw std::runtime_error("cannot read app file");
    return {std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()};
  }
  int write_file(const char *path, const std::string &contents) {
    ++write_attempts;
    if (fail_write) return -1;
    std::ofstream out(path, std::ios::binary | std::ios::trunc);
    if (!out || !(out << contents)) throw std::runtime_error("cannot write app file");
    return 0;
  }
}
namespace uuid_util {
  struct uuid_t {
    static uuid_t generate() { return {}; }
    std::string string() const { return "a-valid-generated-uuid"; }
  };
}
namespace remote_session {
  std::string_view monitor_profile_json_error(const nlohmann::json &, const nlohmann::json &) { return {}; }
}
namespace config {
  input_t input {};
#if defined(_WIN32) || defined(SUNSHINE_TEST_WINDOWS_BUILTIN)
  sunshine_t sunshine {};
#endif
}
#if defined(_WIN32) || defined(SUNSHINE_TEST_WINDOWS_BUILTIN)
namespace VDISPLAY {
@DRIVER_STATUS@
}
#endif
namespace util { int from_view(std::string_view value) { return std::stoi(std::string(value)); } }
namespace proc {
#if defined(_WIN32) || defined(SUNSHINE_TEST_WINDOWS_BUILTIN)
  // The production enum and factory are inserted by the fixture generator;
  // only the driver status is controlled by the test.
  std::atomic<VDISPLAY::DRIVER_STATUS> vDisplayDriverStatus {VDISPLAY::DRIVER_STATUS::UNKNOWN};
@BUILTIN_FACTORY@
#endif
  int input_only_app_id = 123;
  std::string input_only_app_id_str = "123";
  int terminate_app_id = 456;
  std::string terminate_app_id_str = "456";
  std::string_view configured_monitor_profile_error(const nlohmann::json &, const nlohmann::json &) { return {}; }
  std::string_view monitor_profile_changes_error(const nlohmann::json &, const nlohmann::json &, const std::string &) { return {}; }
  void assign_unique_generated_app_id(ctx_t &ctx, int index, std::set<std::string> &, const std::vector<ctx_t> &) {
    ctx.id = std::to_string(index);
  }
  bool is_valid_env_key(const std::string &) { return true; }
  std::string parse_env_val(const bp::environment &, const std::string &value) { return value; }
@MIGRATION@
  std::optional<catalog::snapshot_t> read_snapshot(const std::string &file_name) {
    auto this_env = bp::this_process::env();
    std::set<std::string> ids;
    std::vector<ctx_t> apps;
    std::map<std::string, std::string> app_id_alias_state;
    std::set<std::string> active_app_uuids;
    bool app_id_alias_state_changed = false;
    int i = 0;
@LOAD_LOOP@
    // Actual built-in construction and generated-ID publication are included.
@BUILTIN@
@PERSIST@
    return catalog::snapshot_t {std::move(this_env), std::move(apps)};
  }
}
namespace {
  namespace catalog = proc::catalog;
  struct fixture_t {
    std::atomic<int> app_id {-1}; catalog::environment_t env;
    std::optional<catalog::environment_t> pending;
    std::unordered_set<std::string> stream_keys;
    std::vector<proc::ctx_t> apps; proc::ctx_t active; std::mutex state;
    std::mutex lifecycle; std::shared_mutex config; std::recursive_mutex file;
    int replacements = 0;
    catalog::state_view_t view() { return {app_id, env, pending, stream_keys, apps, active, state}; }
    void seed() { proc::ctx_t app {}; app.id = "42"; app.uuid = "existing"; app.name = "Previous"; apps = {app}; env["CATALOG_MARKER"] = "old-value"; }
    void refresh(const std::filesystem::path &path) {
      catalog::refresh(path.string(), {lifecycle, config, file}, view(),
        [](const std::string &name) { return proc::read_snapshot(name); },
        [this](catalog::snapshot_t &&next) { apps = std::move(next.apps); env = std::move(next.environment); ++replacements; },
        [](auto, auto) { throw std::runtime_error("unexpected retry"); });
    }
  };
  void write(const std::filesystem::path &path, const std::string &value) {
    CHECK(file_handler::write_file(path.string().c_str(), value) == 0);
  }
  void retained(fixture_t &f) {
    CHECK(f.replacements == 0 && f.apps.size() == 1 && f.apps[0].uuid == "existing");
    bool found = false;
    for (const auto &entry : f.env) if (entry.get_name() == "CATALOG_MARKER") found = entry.to_string() == "old-value";
    CHECK(found);
  }
}
int main(int argc, char **argv) {
  CHECK(argc == 2); config::input.enable_input_only_mode = true; const std::filesystem::path root = argv[1]; std::filesystem::create_directories(root);
  const auto file = root / "apps.json";
  fixture_t f; f.seed();
  for (const std::string invalid : {R"({"version":1})", R"({"version":1,"apps":{}})", R"({"version":1,"apps":null})"}) {
    write(file, invalid); f.refresh(file); retained(f);
    CHECK(file_handler::read_file(file.string().c_str()) == invalid);
  }
  f.refresh(root / "missing.json"); retained(f);
  write(file, "{broken"); f.refresh(file); retained(f);
  write(file, R"({"version":2,"apps":{}})"); f.refresh(file); retained(f);
  // First app parses, second fails; no built-in or partial catalog may publish.
  const std::string partial = R"({"version":2,"env":{"CATALOG_MARKER":"new-value"},"apps":[{"uuid":"ok","name":"First","elevated":"yes"},{"uuid":"bad","name":5}]})";
  write(file, partial);
  const auto writes_before_partial = file_handler::write_attempts;
  f.refresh(file); retained(f);
  CHECK(file_handler::read_file(file.string().c_str()) == partial);
  CHECK(file_handler::write_attempts == writes_before_partial);
  // Recovery migration itself fails on an invalid legacy numeric field.
  write(file, R"({"version":1,"apps":[{"name":"Invalid","scale-factor":"not-a-number"}]})");
  f.refresh(file); retained(f);
  // Failed atomic migration persistence must not publish the in-memory result.
  const std::string legacy = R"({"version":1,"apps":[{"name":"Migrated","elevated":"true"}]})";
  write(file, legacy); file_handler::fail_write = true; f.refresh(file); file_handler::fail_write = false;
  retained(f); CHECK(file_handler::read_file(file.string().c_str()) == legacy);
  CHECK(proc::input_only_app_id == 123 && proc::input_only_app_id_str == "123");
  CHECK(proc::terminate_app_id == 456 && proc::terminate_app_id_str == "456");
  // Actual v1-to-v2 migration writes a UUID and converts a legacy boolean.
  write(file, R"({"version":1,"env":{"CATALOG_MARKER":"new-value"},"apps":[{"name":"Migrated","elevated":"true"}]})");
  f.refresh(file); CHECK(f.replacements == 1 && f.apps.size() == 3 && f.apps[0].name == "Migrated" && f.apps[1].uuid == REMOTE_INPUT_UUID && f.apps[2].uuid == TERMINATE_APP_UUID);
  bool saw_new_env = false;
  for (const auto &entry : f.env) if (entry.get_name() == "CATALOG_MARKER") saw_new_env = entry.to_string() == "new-value";
  CHECK(saw_new_env);
  const auto migrated = nlohmann::json::parse(file_handler::read_file(file.string().c_str()));
  CHECK(migrated.at("version") == 2 && migrated.at("apps").at(0).at("elevated") == true && migrated.at("apps").at(0).contains("uuid"));
  // A v2 document with a missing UUID needs a recovery migration after an
  // earlier app was parsed. Publish only the complete retry and write once.
  write(file, R"({"version":2,"env":{"CATALOG_MARKER":"retry-value"},"apps":[{"uuid":"kept","name":"First"},{"name":"Retry","elevated":"yes"}]})");
  const auto writes_before_retry = file_handler::write_attempts;
  f.refresh(file);
  CHECK(f.replacements == 2 && f.apps.size() == 4);
  CHECK(f.apps[0].uuid == "kept" && f.apps[1].name == "Retry" && f.apps[2].uuid == REMOTE_INPUT_UUID && f.apps[3].uuid == TERMINATE_APP_UUID);
  CHECK(file_handler::write_attempts == writes_before_retry + 1);
  const auto recovered = nlohmann::json::parse(file_handler::read_file(file.string().c_str()));
  CHECK(recovered.at("apps").at(1).at("elevated") == true && recovered.at("apps").at(1).contains("uuid"));
  bool saw_retry_env = false;
  for (const auto &entry : f.env) if (entry.get_name() == "CATALOG_MARKER") saw_retry_env = entry.to_string() == "retry-value";
  CHECK(saw_retry_env);
  // Empty-but-valid files publish built-ins, including on first start.
  write(file, R"({"version":2,"apps":[]})");
  fixture_t fresh; fresh.refresh(file); CHECK(fresh.replacements == 1 && fresh.apps.size() == 2 && fresh.apps[0].uuid == REMOTE_INPUT_UUID && fresh.apps[1].uuid == TERMINATE_APP_UUID);
  fixture_t failed_first; failed_first.refresh(root / "missing.json"); CHECK(failed_first.replacements == 0 && failed_first.apps.empty());
#if defined(_WIN32) || defined(SUNSHINE_TEST_WINDOWS_BUILTIN)
  // Exercise the same Windows production branch when the driver is available.
  proc::vDisplayDriverStatus.store(VDISPLAY::DRIVER_STATUS::OK);
  config::sunshine.prep_cmds.emplace_back("prepare", "undo", true);
  config::sunshine.state_cmds.emplace_back("resume", "pause", false);
  write(file, R"({"version":2,"apps":[]})");
  fixture_t driver_ready; driver_ready.refresh(file);
  CHECK(driver_ready.replacements == 1 && driver_ready.apps.size() == 3);
  CHECK(driver_ready.apps[0].uuid == VIRTUAL_DISPLAY_UUID && driver_ready.apps[0].name == "Virtual Display");
  CHECK(driver_ready.apps[0].virtual_display && driver_ready.apps[0].image_path == "virtual_desktop.png");
  CHECK(driver_ready.apps[0].prep_cmds.size() == 1 && driver_ready.apps[0].prep_cmds[0].do_cmd == "prepare");
  CHECK(driver_ready.apps[0].state_cmds.size() == 1 && driver_ready.apps[0].state_cmds[0].do_cmd == "resume");
  CHECK(driver_ready.apps[1].uuid == REMOTE_INPUT_UUID && driver_ready.apps[2].uuid == TERMINATE_APP_UUID);
  // A failed migration write must preserve the previous catalog/environment,
  // even after the Windows virtual-display entry was prepared.
  fixture_t driver_failure; driver_failure.seed();
  write(file, legacy);
  const auto prior_input_id = proc::input_only_app_id;
  const auto prior_terminate_id = proc::terminate_app_id;
  file_handler::fail_write = true; driver_failure.refresh(file); file_handler::fail_write = false;
  retained(driver_failure); CHECK(file_handler::read_file(file.string().c_str()) == legacy);
  CHECK(proc::input_only_app_id == prior_input_id && proc::terminate_app_id == prior_terminate_id);
  proc::vDisplayDriverStatus.store(VDISPLAY::DRIVER_STATUS::FAILED);
  write(file, R"({"version":2,"apps":[]})");
  fixture_t driver_unavailable; driver_unavailable.refresh(file);
  CHECK(driver_unavailable.replacements == 1 && driver_unavailable.apps.size() == 2);
  CHECK(driver_unavailable.apps[0].uuid == REMOTE_INPUT_UUID && driver_unavailable.apps[1].uuid == TERMINATE_APP_UUID);
  proc::vDisplayDriverStatus.store(VDISPLAY::DRIVER_STATUS::UNKNOWN);
#endif
  std::cout << "catalog load failure and migration integration: passed\n";
}
