constexpr int MAX_RTP_HEADER_SIZE = 16, SS_ENC_VIDEO = 4, START_PACING_REJECTED = -2;
struct video_packet_raw_t { char bytes[32]; };
struct video_packet_enc_prefix_t { char bytes[32]; };
struct video_short_frame_header_t { char bytes[8]; };
namespace pyrowave {
  namespace protocol { constexpr int BITSTREAM_FORMAT = 3; }
  namespace policy { @DETAIL_MAX@ }
}
namespace config {
  struct { int pacing_max_bitrate_kbps = 0, fec_percentage = 20,
               pyrowave_critical_fec_percentage = 20, video_max_batch_size_kb = 64;
          bool pacing_batch_demand_limit = false; } stream;
}
struct config_t {
  struct { int bitrate = 150000, client_requested_bitrate = 150000, videoFormat = 1,
               framerate = 120, encodingFramerate = 120000, framerateX100 = 12000;
           bool input_only = false; } monitor;
  int packetsize = 1392, encryptionFlagsEnabled = 0, minRequiredFecPackets = 2;
};
struct session_t;
struct control_server_t { sync_util::sync_t<std::vector<session_t *>> _sessions; };
struct Broadcast { control_server_t control_server; };
auto broadcast = safe::make_shared<Broadcast>([](Broadcast &) { return 0; }, [](Broadcast &) {});
decltype(broadcast)::ptr_t broadcast_owner;
struct session_t {
  config_t config;
  std::string device_uuid = "client";
  safe::mail_t mail = std::make_shared<safe::mail_raw_t>();
  struct address_t { bool is_v6() const { return false; } };
  struct peer_t { address_t address() const { return {}; } };
  struct {
    safe::mail_raw_t::event_t<int> bitrate_events;
    std::atomic<int> pacing_bitrate_kbps {0};
    bool cipher = false;
    peer_t peer;
  } video;
  decltype(broadcast)::ptr_t broadcast_ref;
  session_t() { video.bitrate_events = mail->event<int>("dynamic_bitrate"); }
};
namespace session { void stop(session_t &) {} }
