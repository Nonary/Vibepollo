@CLOSE_WEBRTC@
void shutdown_all_sessions(){std::vector<std::string> ids;{std::lock_guard lock(session_mutex);for(auto &[id,s]:sessions){(void)s;ids.push_back(id);}}for(auto &id:ids)close_session(id);}
}

namespace remote_session {void notify_monitor_shutdown(){topology.shutdown();}}
