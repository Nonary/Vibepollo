namespace nvhttp {
@TERMINAL@
}
void reset() {
 physical=false;terminal_entered=false;late_ordinary=false;armed=true;running=0;finalizer_calls=0;config_applies=0;
 join_pause.reset(false);expiry_pause.reset(false);parser_pause.reset(false);peer_pause.reset(false);
 server._session_state->sessions.clear();server._launch_sessions.clear();server.startup_pool.queue.clear();server.io_context.queue.clear();
 topology.shutdown(true);topology.set_runtime_callbacks({});
}
void terminal(){nvhttp::terminate_all_streams_from_host([]{return true;});}
void wait_terminal_started(){for(int i=0;i<100 && !(host_stream_control::request_ticket()&1);++i) std::this_thread::sleep_for(1ms);}
void blocked_cleanup(Pause &pause,const char *name,std::function<void()> cleanup) {
 auto work=std::async(std::launch::async,std::move(cleanup));pause.reached();
 auto end=std::async(std::launch::async,terminal);wait_terminal_started();
 const bool waited=end.wait_for(30ms)==std::future_status::timeout;
 const bool before=physical || terminal_entered;pause.resume();work.get();end.get();
 check(waited && !before && physical && !late_ordinary,name);
}
int main() {
 launch_session_t metadata;metadata.guide_button=37;metadata.monitor_profile_uuid="exact-monitor-profile";auto copied=metadata.clone_for_startup();check(copied->guide_button==37,"actual startup snapshot preserves Guide metadata");check(copied->monitor_profile_uuid=="exact-monitor-profile","actual startup snapshot preserves Monitor profile metadata");
 reset();running=1;join_pause.reset(true);server._session_state->sessions.insert(std::make_shared<stream::session_t>());
 blocked_cleanup(join_pause,"actual natural clear drains removed owner before recovery",[]{server.clear(false);});
 reset();expiry_pause.reset(true);auto session=std::make_shared<launch_session_t>();server._launch_sessions.emplace_back(rtsp_server_t::launch_session_entry_t{session,std::chrono::steady_clock::now()-1s});
 blocked_cleanup(expiry_pause,"actual expiry extraction/notification finishes before recovery",[]{server.arm_launch_timer();});
 check(config_applies==1,"expiry notification executes once");
 reset();server._launch_sessions.emplace_back(rtsp_server_t::launch_session_entry_t{session,std::chrono::steady_clock::now()+1s});terminal();
 check(config_applies==1 && server._launch_sessions.empty(),"actual terminal cancel releases pending Remote Input owner");
 reset();running=1;peer_pause.reset(true);webrtc_stream::sessions.emplace("old",0);webrtc_stream::active_sessions=1;
 blocked_cleanup(peer_pause,"actual WebRTC removed close drains history/capture tail",[]{webrtc_stream::close_session("old");});
 reset();parser_pause.reset(true);server._launch_sessions.emplace_back(rtsp_server_t::launch_session_entry_t{session,std::chrono::steady_clock::now()+1s});
 std::string payload;
 for(auto key:{"x-nv-audio.surround.numChannels","x-nv-audio.surround.channelMask","x-nv-audio.surround.AudioQuality","x-nv-video[0].packetSize","x-nv-video[0].clientViewportHt","x-nv-video[0].clientViewportWd","x-nv-video[0].maxFPS","x-nv-vqos[0].bw.maximumBitrateKbps","x-nv-video[0].videoEncoderSlicesPerFrame","x-nv-video[0].maxNumReferenceFrames"}) payload+="a="+std::string(key)+":2\n";
 auto request=std::make_shared<Request>();request->payload=payload.data();request->payloadLength=payload.size();
 auto announce=std::async(std::launch::async,[&]{return cmd_announce(&server,std::make_shared<socket_t>(),session,std::move(request));});parser_pause.reached();terminal();const int calls=finalizer_calls;parser_pause.resume();check(!announce.get(),"actual target ANNOUNCE claim rejects removed launch after parser cancellation");server.startup_pool.run();server.io_context.run();
 check(running==0 && finalizer_calls==calls,"actual pre-parser ANNOUNCE ticket prevents late runtime finalizer");
 parser_pause.reset(false);
 // Target ANNOUNCE also has an early identity/claim check. Keep a real pending
 // identity across a bounded failed terminal drain to isolate the ticket fence.
 reset();parser_pause.reset(true);session=std::make_shared<launch_session_t>();server._launch_sessions.emplace_back(rtsp_server_t::launch_session_entry_t{session,std::chrono::steady_clock::now()+1s});
 std::promise<void> entered,release;auto entered_future=entered.get_future();auto released=release.get_future();
 auto inflight=std::async(std::launch::async,[&]{host_stream_control::activity_guard_t activity;entered.set_value();released.wait();});entered_future.wait();
 request=std::make_shared<Request>();request->payload=payload.data();request->payloadLength=payload.size();
 announce=std::async(std::launch::async,[&]{return cmd_announce(&server,std::make_shared<socket_t>(),session,std::move(request));});parser_pause.reached();
 check(!host_stream_control::terminate([]{return true;},[]{physical=true;},5ms) && !physical,"bounded drain failure leaves physical recovery unattempted");
 release.set_value();inflight.get();parser_pause.resume();check(announce.get(),"actual target ANNOUNCE queues old parser only as canceled response after failed drain");
 server.startup_pool.run();server.io_context.run();check(running==0 && finalizer_calls==0,"actual target pre-parser ticket rejects old pending identity after failed drain");
 parser_pause.reset(false);
 // Socket aliases and queued metadata may outlive pending-map removal; neither
 // may retain resource guards capable of restoring audio/power after recovery.
 reset();bool late_resource=false;
 auto pending=std::make_shared<launch_session_t>();
 pending->audio_context_guard=std::shared_ptr<void>(new int(1),[&](void *p){late_resource=physical;delete static_cast<int*>(p);});
 std::weak_ptr<void> resource=pending->audio_context_guard;
 pending->display_power_guard=pending->audio_context_guard;
 server._launch_sessions.emplace_back(rtsp_server_t::launch_session_entry_t{pending,std::chrono::steady_clock::now()+1s});
 auto queued_request=std::make_shared<Request>();queued_request->payload=payload.data();queued_request->payloadLength=payload.size();
 check(cmd_announce(&server,std::make_shared<socket_t>(),pending,std::move(queued_request)),"actual ANNOUNCE queues metadata with pending resource owner");
 terminal();check(resource.expired(),"pending socket/queued aliases release runtime holds before recovery");
 server.startup_pool.run();server.io_context.run();pending.reset();check(!late_resource,"canceled queued/socket destruction has no late resource finalizer");
 // Control: a legitimate worker transfers its holds to active capture; map
 // retirement must not release that active owner before the capture join.
 reset();pending=std::make_shared<launch_session_t>();pending->audio_context_guard=std::make_shared<int>(1);resource=pending->audio_context_guard;
 server._launch_sessions.emplace_back(rtsp_server_t::launch_session_entry_t{pending,std::chrono::steady_clock::now()+1s});
 auto valid_request=std::make_shared<Request>();valid_request->payload=payload.data();valid_request->payloadLength=payload.size();
 check(cmd_announce(&server,std::make_shared<socket_t>(),pending,std::move(valid_request)),"fresh ANNOUNCE is accepted");server.startup_pool.run();check(running==1 && !resource.expired(),"active capture retains admitted resource handoff");terminal();check(resource.expired(),"terminal joins active resource handoff before recovery");server.io_context.run();
 // All nonterminal map-removal paths retire the same shared resources while
 // socket aliases remain alive, so they cannot hide an owner from terminal.
 for(int removal=0;removal<3;++removal) {
   reset();pending=std::make_shared<launch_session_t>();pending->audio_context_guard=std::make_shared<int>(1);resource=pending->audio_context_guard;
   server._launch_sessions.emplace_back(rtsp_server_t::launch_session_entry_t{pending,std::chrono::steady_clock::now()+1s});
   if(removal==0)server.session_clear(1);
   else if(removal==1)server.disconnect_client("one",false);
   else server.disconnect_remote_role("one",remote_session::role_e::input,1);
   check(resource.expired(),removal==0?"actual attached-launch removal retires socket resource alias":removal==1?"actual client disconnect retires socket resource alias":"actual role disconnect retires socket resource alias");
 }
 // Real topology shutdown failure retains the logical identity. Terminal must
 // reject final physical recovery instead of treating finalizer(false) as idle.
 reset();bool fail=false;topology.set_runtime_callbacks({.create_or_reclaim=[](const auto &,const auto &,const auto &){return true;},.apply_composed_topology=[&](const auto &){return !fail;},.exact_target_has_current_mode_and_dxgi=[](const auto &,const auto &){return std::optional<std::string>{"display"};}});
 topology.activate_remote_monitor("owner","owner",{});fail=true;terminal();
 check(topology.managed_client_identity_count()==1 && !physical,"actual topology apply failure prevents final physical cleanup");
 fail=false;terminal();check(topology.managed_client_identity_count()==0 && physical,"topology retry drains owners and permits recovery");
 // A clean idle topology has no restore work; do not reapply the desktop.
 reset();bool applied_idle=false;topology.set_runtime_callbacks({.apply_composed_topology=[&](const auto &){applied_idle=true;return false;}});terminal();
 check(physical && !applied_idle,"clean idle topology permits recovery without reapplying displays");
 // A removed display can leave restore work even after its identity is gone.
 reset();fail=false;topology.set_runtime_callbacks({.create_or_reclaim=[](const auto &,const auto &,const auto &){return true;},.apply_composed_topology=[&](const auto &){return !fail;},.exact_target_has_current_mode_and_dxgi=[](const auto &,const auto &){return std::optional<std::string>{"display"};},.terminate_owned_display=[](const auto &){return true;}});
 topology.activate_or_resume("removed","removed",{},1);fail=true;topology.explicit_release("removed",1,"terminal removal");
 check(topology.managed_client_identity_count()==0 && !topology.shutdown_complete(),"removed display retains pending physical restore");
 terminal();check(!physical,"empty-map pending restore failure prevents final physical cleanup");
 fail=false;terminal();check(physical && topology.shutdown_complete(),"empty-map pending restore succeeds on retry");
 auto fresh=host_stream_control::start_guard_t(host_stream_control::request_ticket());check(bool(fresh),"fresh starts remain eligible after terminal reopen");
 return failures?1:0;
}
