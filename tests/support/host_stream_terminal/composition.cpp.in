struct Pause {
 std::mutex mutex; std::condition_variable cv; bool enabled=false, entered=false, release=false;
 void reset(bool active) { enabled=active; entered=false; release=false; }
 void wait() { std::unique_lock lock(mutex); if(!enabled) return; entered=true; cv.notify_all(); cv.wait(lock,[&]{return release;}); }
 void reached() { std::unique_lock lock(mutex); if(!cv.wait_for(lock,2s,[&]{return entered;})) throw std::runtime_error("pause not reached"); }
 void resume() { {std::lock_guard lock(mutex); release=true;} cv.notify_all(); }
} join_pause, expiry_pause, parser_pause, peer_pause;
std::atomic_bool physical=false, late_ordinary=false, armed=false, terminal_entered=false;
std::atomic_int running=0, finalizer_calls=0, config_applies=0;
int failures=0;
void check(bool ok,const char *name) { std::cout<<(ok?"PASS ":"FAIL ")<<name<<'\n'; if(!ok) ++failures; }
