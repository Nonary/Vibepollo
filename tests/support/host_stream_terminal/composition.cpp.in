// The non-WEBRTC branch of the unchanged real close body still executes map
// removal, teardown publication, history and capture-finalizer ordering.
namespace webrtc_stream {
std::mutex session_mutex;std::atomic_int active_sessions=0,teardown_sessions=0;std::atomic_bool rtsp_sessions_active=false;
