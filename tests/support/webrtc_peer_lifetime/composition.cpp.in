namespace util {
template<class F> struct Guard {F fn;bool enabled=true;void disable(){enabled=false;}~Guard(){if(enabled)fn();}};
template<class F> auto fail_guard(F f){return Guard<F>{std::move(f)};}
}
struct Pause {
 std::mutex mutex;std::condition_variable cv;bool arrived=false,done=false;
 void stop(){std::unique_lock lock(mutex);arrived=true;cv.notify_all();cv.wait(lock,[&]{return done;});}
 void reached(){std::unique_lock lock(mutex);if(!cv.wait_for(lock,1s,[&]{return arrived;}))throw std::runtime_error("pause not reached");}
 void resume(){std::lock_guard lock(mutex);done=true;cv.notify_all();}
};
struct lwrtc_peer_t {bool alive=true;int closes=0;int releases=0;};
struct lwrtc_factory_t {};
struct lwrtc_audio_source_t {};
struct lwrtc_video_source_t {};
struct lwrtc_encoded_video_source_t {};
