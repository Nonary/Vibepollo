int failures=0,checks=0;
void check(bool value,const std::string &name){++checks;std::cout<<(value?"PASS ":"FAIL ")<<name<<'\n';if(!value)++failures;}
void reset(){using namespace webrtc_stream;candidate_hook={};remote_hook={};setup_hook={};release_hook={};channel_hook={};answer_return_hook={};local_return_hook={};inline_failure_stage=-1;inline_callbacks=false;cross_thread_callbacks=false;fail_setup=false;finish();shutdown_all_sessions();finish();sessions.clear();physical=false;proc::pauses=0;rtsp_stream::owns_runtime=false;invalid_uses=0;remote_calls=0;answer_calls=0;local_calls=0;candidate_calls=0;setup_under_map=false;constraints_releases=0;factory_releases=0;audio_source_releases=0;recovery_constraints=-1;recovery_closes=-1;recovery_releases=-1;recovery_factories=-1;recovery_sources=-1;Session session;session.keyframe_context=std::make_shared<SessionKeyframeContext>();session.rate_context=std::make_shared<SessionRateContext>();sessions.emplace("s",std::move(session));active_sessions=1;}
void ready(){using namespace webrtc_stream;set_remote_offer("s","offer","offer");finish();}
void terminal(){nvhttp::terminate_all_streams_from_host([]{return true;});}
void wait_closed(){for(int i=0;i<200 && !(host_stream_control::request_ticket()&1);++i)std::this_thread::sleep_for(1ms);}
void pending_terminal(const std::string &name){auto end=std::async(std::launch::async,terminal);wait_closed();const bool waited=end.wait_for(15ms)==std::future_status::timeout;const bool untouched=!physical;finish();end.get();check(waited && untouched && physical && invalid_uses==0,name);}
void mixed_callback_tail(int deferred_stage,int failure_stage,bool remove_first,bool cross_thread){
 using namespace webrtc_stream;reset();set_remote_offer("s","offer","offer");for(int i=0;i<deferred_stage;++i)complete();
 auto *peer=peers.back().get();Pause returning;inline_callbacks=true;cross_thread_callbacks=cross_thread;inline_failure_stage=failure_stage;
 if(deferred_stage==0)answer_return_hook=[&]{returning.stop();};else local_return_hook=[&]{returning.stop();};
 auto callback_work=std::async(std::launch::async,[]{complete();});returning.reached();
 std::size_t counted;{std::lock_guard lock(host_stream_control::state().mutex);counted=host_stream_control::state().active;}
 if(remove_first)close_session("s");
 auto stop=std::async(std::launch::async,terminal);wait_closed();const bool waited=stop.wait_for(40ms)==std::future_status::timeout;const bool untouched=!physical;
 const auto prefix="mixed deferred="+std::to_string(deferred_stage)+" inline-failure="+std::to_string(failure_stage)+" DELETE="+std::to_string(remove_first)+" cross-thread="+std::to_string(cross_thread);
 check(counted>0 && waited && untouched,prefix+" retains admission through enclosing native call");
 Pause releasing;if(remove_first)release_hook=[&]{releasing.stop();};
 returning.resume();
 if(remove_first){releasing.reached();const bool release_waited=stop.wait_for(40ms)==std::future_status::timeout;check(release_waited && !physical,prefix+" reservation spans final wrapper release after transferred context");releasing.resume();}
 callback_work.get();stop.get();answer_return_hook={};local_return_hook={};release_hook={};
 check(peer->closes==1 && peer->releases==1 && invalid_uses==0,prefix+" releases retired peer exactly once");
 check(recovery_constraints==1 && recovery_closes==1 && recovery_releases==1 && recovery_factories==1 && recovery_sources==1,prefix+" recovery follows constraints and all owned resource cleanup");
}
int main(int argc,char **argv){std::cout.setf(std::ios::unitbuf);using namespace webrtc_stream;const bool full_drain=argc>1 && std::string_view(argv[1])=="--full-drain";
 reset();ready();check(!setup_under_map,"setup SDK calls can reenter session map");check(sessions.at("s").state.has_local_answer && invalid_uses==0,"fresh complete negotiation control");
 reset();ready();Pause ice;candidate_hook=[&]{ice.stop();};auto trickle=std::async(std::launch::async,[]{return add_ice_candidate("s","video",0,"ice");});ice.reached();auto end=std::async(std::launch::async,terminal);wait_closed();bool waited=end.wait_for(15ms)==std::future_status::timeout;ice.resume();trickle.get();end.get();check(waited && physical && invalid_uses==0,"actual ICE call drains before terminal release");
 reset();Pause offer;remote_hook=[&]{offer.stop();};auto start=std::async(std::launch::async,[]{return set_remote_offer("s","offer","offer");});offer.reached();auto stop=std::async(std::launch::async,terminal);wait_closed();waited=stop.wait_for(15ms)==std::future_status::timeout;offer.resume();start.get();finish();stop.get();check(waited && physical && invalid_uses==0,"actual offer plus continuation drain before terminal release");
 for(int stage=0;stage<3;++stage){reset();set_remote_offer("s","offer","offer");for(int i=0;i<stage;++i)complete();pending_terminal("pending SDP stage "+std::to_string(stage)+" is counted through final completion");}
 for(int stage=0;stage<3;++stage){reset();set_remote_offer("s","offer","offer");for(int i=0;i<stage;++i)complete();auto *peer=peers.back().get();close_session("s");const bool deferred=peer->releases==0 && peer->closes==1;const int before=answer_calls+local_calls;finish();check(deferred && peer->releases==1 && answer_calls+local_calls==before && invalid_uses==0,"DELETE retires pending stage "+std::to_string(stage)+" without raw-wrapper use/release");}
 reset();ready();Pause ice_delete;candidate_hook=[&]{ice_delete.stop();};auto ice_work=std::async(std::launch::async,[]{return add_ice_candidate("s","video",0,"ice");});ice_delete.reached();auto *peer=peers.back().get();close_session("s");const bool sdk_deferred=peer->closes==0 && peer->releases==0;ice_delete.resume();ice_work.get();check(sdk_deferred && peer->closes==1 && peer->releases==1 && invalid_uses==0,"DELETE defers SDK Close itself across admitted ICE call");
 reset();ready();Pause channel;channel_hook=[&]{channel.stop();};auto data_context=sessions.at("s").data_channel_context;auto channel_work=std::async(std::launch::async,[&]{on_data_channel(data_context.get(),new lwrtc_data_channel_t);});channel.reached();auto channel_terminal=std::async(std::launch::async,terminal);wait_closed();const bool channel_waited=channel_terminal.wait_for(15ms)==std::future_status::timeout;channel.resume();channel_work.get();channel_terminal.get();check(channel_waited && physical && invalid_uses==0,"actual data-channel callback drains before terminal recovery");
 reset();set_remote_offer("s","offer","offer");auto *release_peer=peers.back().get();close_session("s");
 if(release_peer->releases!=0){finish();check(false,"callback count spans final retired wrapper/resource release");}
 else {Pause releasing;release_hook=[&]{releasing.stop();};auto callback_work=std::async(std::launch::async,[]{finish();});releasing.reached();auto release_terminal=std::async(std::launch::async,terminal);wait_closed();const bool release_waited=release_terminal.wait_for(15ms)==std::future_status::timeout;const bool no_physical=!physical;releasing.resume();callback_work.get();release_terminal.get();release_hook={};check(release_waited && no_physical && physical && release_peer->releases==1,"callback count spans final retired wrapper/resource release");}
 reset();set_remote_offer("s","offer","offer");bool attempted=false;const bool bounded=host_stream_control::terminate([]{return true;},[&]{attempted=true;},20ms);check(!bounded && !attempted && !(host_stream_control::request_ticket()&1),"missing callback fails bounded drain and reopens without recovery");finish();terminal();check(physical && invalid_uses==0,"completion after failed drain permits explicit retry");
 for(int stage=0;stage<3;++stage){reset();set_remote_offer("s","offer","offer");for(int i=0;i<stage;++i)complete();complete(true);terminal();check(physical && host_stream_control::state().active==0 && invalid_uses==0,"failure callback stage "+std::to_string(stage)+" retires counted operation");}
 reset();inline_callbacks=true;cross_thread_callbacks=true;set_remote_offer("s","offer","offer");check(sessions.at("s").state.has_local_answer && host_stream_control::state().active==0,"cross-thread synchronous SDK completions do not deadlock");terminal();check(physical && invalid_uses==0,"inline callback chain retires before physical recovery");
 reset();fail_setup=true;const bool failed=!set_remote_offer("s","offer","offer");auto *failed_peer=peers.back().get();fail_setup=false;ready();check(failed && failed_peer->releases==1 && sessions.at("s").state.has_local_answer && invalid_uses==0,"partial setup retirement preserves retry control");
 reset();set_remote_offer("s","offer","offer");auto short_terminal=std::async(std::launch::async,[]{return host_stream_control::terminate([]{return true;},[]{},40ms);});wait_closed();const auto before_candidates=sessions.at("s").candidates.size();const bool rejected=!add_ice_candidate("s","video",0,"closed")&&!set_remote_offer("s","late","offer");check(rejected && sessions.at("s").candidates.size()==before_candidates,"closed admission rejects new ICE and offers before mutation");short_terminal.get();finish();terminal();
 reset();Pause setup;setup_hook=[&]{setup.stop();};auto setting_up=std::async(std::launch::async,[]{return set_remote_offer("s","offer","offer");});setup.reached();auto remove=std::async(std::launch::async,[]{return close_session("s");});const bool removed=remove.wait_for(200ms)==std::future_status::ready;if(removed)remove.get();setup.resume();const bool unpublished=!setting_up.get();if(!removed)remove.get();finish();check(removed && unpublished && peers.back()->releases==1 && invalid_uses==0,"DELETE during unpublished setup never waits for SDK or republishes removed owner");
 for(bool cross_thread:{false,true})for(bool remove_first:{false,true})for(int failure_stage:{-1,1,2})mixed_callback_tail(0,failure_stage,remove_first,cross_thread);
 for(bool remove_first:{false,true})for(int failure_stage:{-1,2})mixed_callback_tail(1,failure_stage,remove_first,true);
 reset();fail_setup=true;Pause partial_release;release_hook=[&]{partial_release.stop();};auto failed_setup=std::async(std::launch::async,[]{return set_remote_offer("s","offer","offer");});partial_release.reached();auto partial_terminal=std::async(std::launch::async,terminal);wait_closed();const bool partial_waited=partial_terminal.wait_for(40ms)==std::future_status::timeout;const bool partial_untouched=!physical;partial_release.resume();const bool setup_failed=!failed_setup.get();partial_terminal.get();release_hook={};check(setup_failed && partial_waited && partial_untouched && physical && invalid_uses==0,"partial setup reservation spans final wrapper release before terminal recovery");
 if(full_drain){reset();set_remote_offer("s","offer","offer");const auto started=std::chrono::steady_clock::now();terminal();const auto elapsed=std::chrono::steady_clock::now()-started;check(!physical && elapsed>=29s && elapsed<35s && !(host_stream_control::request_ticket()&1),"actual terminal missing completion fails default 30-second drain without recovery");finish();terminal();check(physical && invalid_uses==0,"explicit retry recovers after late completion of default drain");}
 reset();ready();close_session("s");check(proc::pauses==1,"target last WebRTC close preserves app pause");
 reset();ready();rtsp_stream::owns_runtime=true;close_session("s");check(proc::pauses==0,"target pending RTSP owner prevents app pause");
 reset();shutdown_all_sessions();finish();check(host_stream_control::state().active==0 && teardown_sessions==0,"all operation and cleanup reservations retire");
 std::cout<<checks-failures<<"/"<<checks<<" checks passed; "<<failures<<" failed\n";return failures?1:0;
}
