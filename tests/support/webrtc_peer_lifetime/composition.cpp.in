std::atomic_int invalid_uses=0,remote_calls=0,answer_calls=0,local_calls=0,candidate_calls=0;
std::atomic_bool setup_under_map=false;
std::atomic_int constraints_releases=0,factory_releases=0,audio_source_releases=0;
std::function<void()> candidate_hook,remote_hook,setup_hook,release_hook,channel_hook,answer_return_hook,local_return_hook;
bool inline_callbacks=false,cross_thread_callbacks=false,fail_setup=false;int inline_failure_stage=-1;
struct Completion {int stage;std::function<void()> ok,fail;};
std::mutex completion_mutex;std::deque<Completion> completions;
void access(lwrtc_peer_t *p){if(!p || !p->alive)++invalid_uses;}
void callback(std::function<void()> fn){if(cross_thread_callbacks){std::thread thread(std::move(fn));thread.join();}else fn();}
void schedule(Completion completion){if(inline_callbacks){callback(completion.stage==inline_failure_stage?completion.fail:completion.ok);return;}std::lock_guard lock(completion_mutex);completions.push_back(std::move(completion));}
int next_stage(){std::lock_guard lock(completion_mutex);return completions.empty()?-1:completions.front().stage;}
void complete(bool fail=false){Completion c;{std::lock_guard lock(completion_mutex);if(completions.empty())return;c=std::move(completions.front());completions.pop_front();}callback(fail?std::move(c.fail):std::move(c.ok));}
void finish(){for(int i=0;i<20 && next_stage()!=-1;++i)complete();}
void lwrtc_peer_close(lwrtc_peer_t *p){access(p);++p->closes;}
void lwrtc_peer_release(lwrtc_peer_t *p){if(release_hook)release_hook();access(p);++p->releases;p->alive=false;}
void lwrtc_factory_release(lwrtc_factory_t *p){++factory_releases;delete p;}
void lwrtc_audio_source_release(lwrtc_audio_source_t *p){++audio_source_releases;delete p;}
int lwrtc_audio_source_push(lwrtc_audio_source_t*,const void*,int,int,int,std::size_t){return 1;}
void lwrtc_video_source_release(lwrtc_video_source_t *p){delete p;}
void lwrtc_encoded_video_source_release(lwrtc_encoded_video_source_t *p){delete p;}
void lwrtc_audio_track_release(lwrtc_audio_track_t *p){delete p;}
void lwrtc_video_track_release(lwrtc_video_track_t *p){delete p;}
void lwrtc_data_channel_release(lwrtc_data_channel_t *p){delete p;}
const char *lwrtc_data_channel_label(lwrtc_data_channel_t *){if(channel_hook)channel_hook();return "input";}
void lwrtc_data_channel_register_observer(lwrtc_data_channel_t *,void(*)(void*,int),void(*)(void*,const char*,int,int),void*){}
void lwrtc_data_channel_unregister_observer(lwrtc_data_channel_t *){}
void lwrtc_data_channel_close(lwrtc_data_channel_t *){}
void lwrtc_encoded_video_source_set_keyframe_callback(lwrtc_encoded_video_source_t *,void(*)(void*),void*){}
void lwrtc_encoded_video_source_set_rate_callback(lwrtc_encoded_video_source_t *,void(*)(void*,uint32_t,uint32_t),void*){}
void lwrtc_peer_register_state_callback(lwrtc_peer_t *p,void(*)(void*,int),void*){access(p);}
void lwrtc_peer_register_data_channel(lwrtc_peer_t *p,void(*)(void*,lwrtc_data_channel_t*),void*){access(p);}
void lwrtc_peer_add_candidate(lwrtc_peer_t *p,const char*,int,const char*){if(candidate_hook)candidate_hook();access(p);++candidate_calls;}
void lwrtc_peer_set_remote_description(lwrtc_peer_t *p,const char*,const char*,void(*ok)(void*),void(*err)(void*,const char*),void *user){if(remote_hook)remote_hook();access(p);++remote_calls;schedule({0,[=]{ok(user);},[=]{err(user,"remote failed");}});}
void lwrtc_peer_create_answer(lwrtc_peer_t *p,void(*ok)(void*,const char*,const char*),void(*err)(void*,const char*),lwrtc_constraints_t*,void *user){access(p);++answer_calls;schedule({1,[=]{ok(user,"answer","answer");},[=]{err(user,"answer failed");}});if(answer_return_hook)answer_return_hook();}
void lwrtc_peer_set_local_description(lwrtc_peer_t *p,const char*,const char*,void(*ok)(void*),void(*err)(void*,const char*),void *user){access(p);++local_calls;schedule({2,[=]{ok(user);},[=]{err(user,"local failed");}});if(local_return_hook)local_return_hook();}
void lwrtc_constraints_release(lwrtc_constraints_t *p){++constraints_releases;delete p;}
