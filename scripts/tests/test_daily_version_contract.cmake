cmake_minimum_required(VERSION 3.25)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
# Exercise the actual WiX version calculation without configuring the application.
file(READ "${repo}/cmake/packaging/windows_wix.cmake" wix)
string(FIND "${wix}" "set(_RAW_VER" start)
string(FIND "${wix}" "# Merge our custom actions" finish)
if(start LESS 0 OR finish LESS start)
  message(FATAL_ERROR "WiX version calculation could not be located; review the daily version contract.")
endif()
math(EXPR length "${finish} - ${start}")
string(SUBSTRING "${wix}" ${start} ${length} calculation)
string(FIND "${wix}" "# Daily packages forbid" policy_start)
string(FIND "${wix}" "# The patch fragment" policy_finish)
math(EXPR policy_length "${policy_finish} - ${policy_start}")
string(SUBSTRING "${wix}" ${policy_start} ${policy_length} policy_calculation)

function(check_version full expected)
  set(BUILD_VERSION "${full}")
  include("${repo}/cmake/prep/build_version.cmake")
  if(NOT PROJECT_VERSION_FULL STREQUAL full)
    message(FATAL_ERROR "Application version lost daily metadata: ${PROJECT_VERSION_FULL}")
  endif()
  cmake_language(EVAL CODE "${calculation}")
  cmake_language(EVAL CODE "${policy_calculation}")
  if(full MATCHES "-daily[.]" AND NOT SUNSHINE_DAILY_UNSIGNED_DRIVER_POLICY EQUAL 1)
    message(FATAL_ERROR "Daily MSI must prohibit automatic driver trust changes.")
  elseif(NOT full MATCHES "-daily[.]" AND NOT SUNSHINE_DAILY_UNSIGNED_DRIVER_POLICY EQUAL 0)
    message(FATAL_ERROR "Stable MSI production driver policy changed.")
  endif()
  if(NOT CPACK_WIX_PRODUCT_VERSION STREQUAL expected)
    message(FATAL_ERROR "Unexpected MSI version: ${full} -> ${CPACK_WIX_PRODUCT_VERSION}; expected ${expected}")
  endif()
endfunction()

unset(ENV{BUILD_VERSION})
check_version("2.0.0-daily.d20261011+aaaaaaaaaaaa" "2.0.90.0")
check_version("2.0.0-daily.d20261012+bbbbbbbbbbbb" "2.0.90.0")
check_version("2.0.0" "2.0.99.0")
check_version("255.255.654-daily.d20991231+aaaaaaaaaaaa" "255.255.65490.0")
message(STATUS "Daily application metadata retained; MSI daily ranks below stable at the same numeric base.")
