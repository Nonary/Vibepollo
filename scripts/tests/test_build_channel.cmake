cmake_minimum_required(VERSION 3.25)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
unset(ENV{BUILD_VERSION})
unset(ENV{BUILD_CHANNEL})
function(check_channel version requested expected)
  set(BUILD_VERSION "${version}")
  set(BUILD_CHANNEL "${requested}")
  include("${repo}/cmake/prep/build_version.cmake")
  if(NOT PROJECT_BUILD_CHANNEL STREQUAL expected)
    message(FATAL_ERROR "${version}/${requested}: got ${PROJECT_BUILD_CHANNEL}, expected ${expected}")
  endif()
  if(NOT "PROJECT_BUILD_CHANNEL=\"${expected}\"" IN_LIST SUNSHINE_DEFINITIONS)
    message(FATAL_ERROR "channel missing from compiled definitions")
  endif()
endfunction()
check_channel("2.0.16" "nightly" "nightly")
check_channel("2.0.16" "stable" "stable")
check_channel("2.0.16" "prerelease" "prerelease")
check_channel("2.0.16-nightly.d20261101.aaaaaaaaaaaa" "" "nightly")
check_channel("2.0.16-beta.1" "" "prerelease")
check_channel("2.0.16-stable.1" "" "stable")
check_channel("2.0.16+build-meta" "" "legacy")
check_channel("2.0.16" "" "legacy")
